---
import { getEmDashCollection } from "emdash";

interface Props {
	origin: string;
	pathname: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
}

const {
	origin,
	pathname,
	pageTitle,
	description,
	image,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
} = Astro.props;

interface SeoSettingRow {
	title?: string;
	organization_name?: string;
	organization_type?: string;
	description?: string;
	phone?: string;
	email?: string;
	address_locality?: string;
	address_region?: string;
	address_country?: string;
	same_as?: string;
	services?: string;
	default_og_image?: string;
}

const DEFAULT_SERVICES = [
	"Jasa Pembuatan Software Custom & Web Application",
	"Aplikasi POS Kasir Toko & Ritel Tanpa Biaya Bulanan",
	"Sistem CRM Penjualan B2B & Manajemen Pipeline",
	"Jasa Install Software Online Jarak Jauh (AutoCAD, SketchUp, Adobe)",
	"Servis Komputer & Laptop Surabaya - Sidoarjo On-Site",
	"Upgrade SSD M.2 NVMe & RAM Laptop Surabaya",
	"Jasa Install Windows 10 & Windows 11 Panggilan",
	"Jasa Install Software MacBook & Apple Silicon M1-M4",
	"Jasa Setup Dual Boot Windows & Linux Bersih",
];

let seoRow: SeoSettingRow | null = null;
try {
	const res = await getEmDashCollection("seo_settings", { limit: 1 });
	if (res && res.entries && res.entries.length > 0) {
		seoRow = res.entries[0].data as SeoSettingRow;
	}
} catch {
	seoRow = null;
}

const orgName = seoRow?.organization_name?.trim() || "Kotacom Indonesia";
const orgDesc =
	seoRow?.description?.trim() ||
	description ||
	"Percetakan buku terpercaya, cetak novel satuan, buku tahunan, majalah, dan solusi digital web IT profesional.";
const orgPhone = seoRow?.phone?.trim() || "+6285799520350";
const orgEmail = seoRow?.email?.trim();
const locality = seoRow?.address_locality?.trim() || "Surabaya & Sidoarjo";
const region = seoRow?.address_region?.trim() || "Jawa Timur";
const country = seoRow?.address_country?.trim() || "ID";

const sameAsList = (seoRow?.same_as || "")
	.split("\n")
	.map((s) => s.trim())
	.filter(Boolean);

const rawServices = (seoRow?.services || "")
	.split("\n")
	.map((s) => s.trim())
	.filter(Boolean);
const servicesList = rawServices.length > 0 ? rawServices : DEFAULT_SERVICES;

const currentUrl = `${origin}${pathname === "/" ? "" : pathname}`;
const logoUrl = image || seoRow?.default_og_image || `${origin}/images/logo.png`;

// Detect Target City from URL pathname for localized Service Schema
let detectedCity: string | null = null;
const pathLower = pathname.toLowerCase();
if (pathLower.includes("surabaya")) detectedCity = "Surabaya";
else if (pathLower.includes("sidoarjo")) detectedCity = "Sidoarjo";
else if (pathLower.includes("mojokerto")) detectedCity = "Mojokerto";
else if (pathLower.includes("gresik")) detectedCity = "Gresik";
else if (pathLower.includes("malang")) detectedCity = "Malang";
else if (pathLower.includes("pasuruan")) detectedCity = "Pasuruan";

// 1. Main Organization & Multi-Service Hub
const organizationSchema: Record<string, any> = {
	"@type": ["LocalBusiness", "ProfessionalService"],
	"@id": `${origin}/#organization`,
	"name": orgName,
	"url": origin,
	"logo": {
		"@type": "ImageObject",
		"url": logoUrl,
	},
	"description": orgDesc,
	"telephone": orgPhone,
	"priceRange": "Rp 50.000 - Rp 35.000.000+",
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
			"opens": "08:00",
			"closes": "22:00",
		},
	],
	"knowsLanguage": ["id-ID", "en-US"],
	"address": {
		"@type": "PostalAddress",
		"addressLocality": locality,
		"addressRegion": region,
		"addressCountry": country,
	},
	"areaServed": [
		{ "@type": "City", "name": "Surabaya" },
		{ "@type": "City", "name": "Sidoarjo" },
		{ "@type": "City", "name": "Mojokerto" },
		{ "@type": "City", "name": "Gresik" },
		{ "@type": "City", "name": "Malang" },
		{ "@type": "City", "name": "Pasuruan" },
		{ "@type": "Country", "name": "Indonesia" },
	],
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "4.9",
		"reviewCount": "128",
		"bestRating": "5",
		"worstRating": "1",
	},
	"subOrganization": [
		{ "@id": `${origin}/#workshop-surabaya` },
		{ "@id": `${origin}/#workshop-sidoarjo` },
	],
};

if (orgEmail) organizationSchema["email"] = orgEmail;
if (sameAsList.length > 0) organizationSchema["sameAs"] = sameAsList;

if (servicesList.length > 0) {
	organizationSchema["hasOfferCatalog"] = {
		"@type": "OfferCatalog",
		"name": "Kotacom Printing & IT Solutions Catalog",
		"itemListElement": servicesList.map((service, idx) => ({
			"@type": "Offer",
			"itemOffered": {
				"@type": "Service",
				"name": service,
			},
			"position": idx + 1,
		})),
	};
}

// 2. Specific Workshop Branch 1: Surabaya
const workshopSurabayaSchema: Record<string, any> = {
	"@type": ["LocalBusiness", "ProfessionalService"],
	"@id": `${origin}/#workshop-surabaya`,
	"name": "Kotacom Surabaya - Percetakan Buku & Solusi IT",
	"url": origin,
	"telephone": orgPhone,
	"priceRange": "Rp 10.000 - Rp 35.000.000+",
	"parentOrganization": { "@id": `${origin}/#organization` },
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "Jl. Tenggilis Mulya 76, Kendangsari, Kec. Tenggilis Mejoyo",
		"addressLocality": "Kota Surabaya",
		"addressRegion": "Jawa Timur",
		"postalCode": "60292",
		"addressCountry": "ID",
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": -7.3195,
		"longitude": 112.7562,
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
			"opens": "08:00",
			"closes": "22:00",
		},
	],
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "4.9",
		"reviewCount": "76",
		"bestRating": "5",
		"worstRating": "1",
	},
};

// 3. Specific Workshop Branch 2: Sidoarjo
const workshopSidoarjoSchema: Record<string, any> = {
	"@type": ["LocalBusiness", "ProfessionalService"],
	"@id": `${origin}/#workshop-sidoarjo`,
	"name": "Kotacom Sidoarjo - Percetakan Buku & Solusi IT",
	"url": origin,
	"telephone": orgPhone,
	"priceRange": "Rp 50.000 - Rp 35.000.000+",
	"parentOrganization": { "@id": `${origin}/#organization` },
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "Graha Indraprasta G7/15",
		"addressLocality": "Kabupaten Sidoarjo",
		"addressRegion": "Jawa Timur",
		"postalCode": "61252",
		"addressCountry": "ID",
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": -7.4478,
		"longitude": 112.7183,
	},
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
			"opens": "08:00",
			"closes": "22:00",
		},
	],
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "4.9",
		"reviewCount": "52",
		"bestRating": "5",
		"worstRating": "1",
	},
};

// 4. WebSite schema
const websiteSchema = {
	"@type": "WebSite",
	"@id": `${origin}/#website`,
	"url": origin,
	"name": orgName,
	"publisher": { "@id": `${origin}/#organization` },
	"inLanguage": "id-ID",
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${origin}/search?q={search_term_string}`,
		"query-input": "required name=search_term_string",
	},
};

// 5. Page / Article / Service schema
const isHome = pathname === "/" || pathname === "";
const isServicePage = pathname.startsWith("/jasa-") || pathname.includes("service") || pathname.includes("software");

const pageSchema: Record<string, any> = type === "article"
	? {
			"@type": "Article",
			"@id": `${currentUrl}/#article`,
			"isPartOf": { "@id": `${origin}/#website` },
			"author": {
				"@type": "Organization",
				"name": author || orgName,
			},
			"headline": pageTitle || orgName,
			"datePublished": publishedTime || undefined,
			"dateModified": modifiedTime || publishedTime || undefined,
			"mainEntityOfPage": currentUrl,
			"image": image || undefined,
	  }
	: {
			"@type": isHome ? "WebPage" : "ItemPage",
			"@id": `${currentUrl}/#webpage`,
			"url": currentUrl,
			"name": pageTitle || orgName,
			"isPartOf": { "@id": `${origin}/#website` },
			"about": { "@id": `${origin}/#organization` },
			"description": description || orgDesc,
			"inLanguage": "id-ID",
	  };

const graph: any[] = [organizationSchema, workshopSurabayaSchema, workshopSidoarjoSchema, websiteSchema, pageSchema];

if (isServicePage && !isHome && type !== "article") {
	const serviceSchema: Record<string, any> = {
		"@type": "Service",
		"@id": `${currentUrl}/#service`,
		"name": pageTitle || orgName,
		"description": description || orgDesc,
		"provider": { "@id": `${origin}/#organization` },
		"areaServed": detectedCity
			? { "@type": "City", "name": detectedCity }
			: organizationSchema["areaServed"],
		"offers": {
			"@type": "Offer",
			"price": "50000",
			"priceCurrency": "IDR",
			"availability": "https://schema.org/InStock",
			"url": currentUrl,
		},
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": "4.9",
			"reviewCount": "128",
			"bestRating": "5",
			"worstRating": "1",
		},
	};
	graph.push(serviceSchema);
}

const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": graph,
});
---

<script type="application/ld+json" set:html={jsonLd} />
