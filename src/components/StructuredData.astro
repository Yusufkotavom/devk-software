---
import { getEmDashCollection } from "emdash";

interface Props {
	origin: string;
	pathname: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
}

const { origin, pathname, pageTitle, description, image } = Astro.props;

interface SeoSettingRow {
	title?: string;
	organization_name?: string;
	organization_type?: string;
	description?: string;
	phone?: string;
	email?: string;
	address_locality?: string;
	address_region?: string;
	address_country?: string;
	same_as?: string;
	services?: string;
	default_og_image?: string;
	// Workshop branches (CMS-driven). Fallbacks below keep the schema valid
	// before these fields are populated in the CMS.
	workshop_surabaya_name?: string;
	workshop_surabaya_address?: string;
	workshop_surabaya_locality?: string;
	workshop_surabaya_region?: string;
	workshop_surabaya_postal_code?: string;
	workshop_surabaya_lat?: string;
	workshop_surabaya_lng?: string;
	workshop_sidoarjo_name?: string;
	workshop_sidoarjo_address?: string;
	workshop_sidoarjo_locality?: string;
	workshop_sidoarjo_region?: string;
	workshop_sidoarjo_postal_code?: string;
	workshop_sidoarjo_lat?: string;
	workshop_sidoarjo_lng?: string;
}

const DEFAULT_SERVICES = [
	"Jasa Pembuatan Software Custom & Web Application",
	"Aplikasi POS Kasir Toko & Ritel Tanpa Biaya Bulanan",
	"Sistem CRM Penjualan B2B & Manajemen Pipeline",
	"Jasa Install Software Online Jarak Jauh (AutoCAD, SketchUp, Adobe)",
	"Servis Komputer & Laptop Surabaya - Sidoarjo On-Site",
	"Upgrade SSD M.2 NVMe & RAM Laptop Surabaya",
	"Jasa Install Windows 10 & Windows 11 Panggilan",
	"Jasa Install Software MacBook & Apple Silicon M1-M4",
	"Jasa Setup Dual Boot Windows & Linux Bersih",
];

let seoRow: SeoSettingRow | null = null;
try {
	const res = await getEmDashCollection("seo_settings", { limit: 1 });
	if (res && res.entries && res.entries.length > 0) {
		seoRow = res.entries[0].data as SeoSettingRow;
	}
} catch {
	seoRow = null;
}

const orgName = seoRow?.organization_name?.trim() || "Kotacom Indonesia";
const orgDesc =
	seoRow?.description?.trim() ||
	description ||
	"Percetakan buku terpercaya, cetak novel satuan, buku tahunan, majalah, dan solusi digital web IT profesional.";
const orgPhone = seoRow?.phone?.trim() || "";
const orgEmail = seoRow?.email?.trim();
const locality = seoRow?.address_locality?.trim() || "Surabaya & Sidoarjo";
const region = seoRow?.address_region?.trim() || "Jawa Timur";
const country = seoRow?.address_country?.trim() || "ID";

const sameAsList = (seoRow?.same_as || "")
	.split("\n")
	.map((s) => s.trim())
	.filter(Boolean);

const rawServices = (seoRow?.services || "")
	.split("\n")
	.map((s) => s.trim())
	.filter(Boolean);
const servicesList = rawServices.length > 0 ? rawServices : DEFAULT_SERVICES;

const currentUrl = `${origin}${pathname === "/" ? "" : pathname}`;
const logoUrl = image || seoRow?.default_og_image || `${origin}/images/logo.png`;

// Detect target city from URL pathname for localized Service schema.
let detectedCity: string | null = null;
const pathLower = pathname.toLowerCase();
if (pathLower.includes("surabaya")) detectedCity = "Surabaya";
else if (pathLower.includes("sidoarjo")) detectedCity = "Sidoarjo";
else if (pathLower.includes("mojokerto")) detectedCity = "Mojokerto";
else if (pathLower.includes("gresik")) detectedCity = "Gresik";
else if (pathLower.includes("malang")) detectedCity = "Malang";
else if (pathLower.includes("pasuruan")) detectedCity = "Pasuruan";

// Workshop branch data — CMS-first, with fallbacks so schema stays valid.
const wsbyName = seoRow?.workshop_surabaya_name?.trim() || "Kotacom Surabaya - Percetakan Buku & Solusi IT";
const wsbyAddr = seoRow?.workshop_surabaya_address?.trim() || "Jl. Tenggilis Mulya 76, Kendangsari, Kec. Tenggilis Mejoyo";
const wsbyLoc = seoRow?.workshop_surabaya_locality?.trim() || "Kota Surabaya";
const wsbyReg = seoRow?.workshop_surabaya_region?.trim() || "Jawa Timur";
const wsbyPost = seoRow?.workshop_surabaya_postal_code?.trim() || "60292";
const wsbyLat = Number(seoRow?.workshop_surabaya_lat) || -7.3195;
const wsbyLng = Number(seoRow?.workshop_surabaya_lng) || 112.7562;

const wsidName = seoRow?.workshop_sidoarjo_name?.trim() || "Kotacom Sidoarjo - Percetakan Buku & Solusi IT";
const wsidAddr = seoRow?.workshop_sidoarjo_address?.trim() || "Graha Indraprasta G7/15";
const wsidLoc = seoRow?.workshop_sidoarjo_locality?.trim() || "Kabupaten Sidoarjo";
const wsidReg = seoRow?.workshop_sidoarjo_region?.trim() || "Jawa Timur";
const wsidPost = seoRow?.workshop_sidoarjo_postal_code?.trim() || "61252";
const wsidLat = Number(seoRow?.workshop_sidoarjo_lat) || -7.4478;
const wsidLng = Number(seoRow?.workshop_sidoarjo_lng) || 112.7183;

// 1. Main Organization & multi-service hub.
const organizationSchema: Record<string, any> = {
	"@type": ["LocalBusiness", "ProfessionalService"],
	"@id": `${origin}/#organization`,
	"name": orgName,
	"url": origin,
	"logo": { "@type": "ImageObject", "url": logoUrl },
	"description": orgDesc,
	"priceRange": "Rp 50.000 - Rp 35.000.000+",
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
			"opens": "08:00",
			"closes": "22:00",
		},
	],
	"knowsLanguage": ["id-ID", "en-US"],
	"address": {
		"@type": "PostalAddress",
		"addressLocality": locality,
		"addressRegion": region,
		"addressCountry": country,
	},
	"areaServed": [
		{ "@type": "City", "name": "Surabaya" },
		{ "@type": "City", "name": "Sidoarjo" },
		{ "@type": "City", "name": "Mojokerto" },
		{ "@type": "City", "name": "Gresik" },
		{ "@type": "City", "name": "Malang" },
		{ "@type": "City", "name": "Pasuruan" },
		{ "@type": "Country", "name": "Indonesia" },
	],
	"subOrganization": [
		{ "@id": `${origin}/#workshop-surabaya` },
		{ "@id": `${origin}/#workshop-sidoarjo` },
	],
};

if (orgPhone) organizationSchema["telephone"] = orgPhone;
if (orgEmail) organizationSchema["email"] = orgEmail;
if (sameAsList.length > 0) organizationSchema["sameAs"] = sameAsList;

if (servicesList.length > 0) {
	organizationSchema["hasOfferCatalog"] = {
		"@type": "OfferCatalog",
		"name": "Kotacom Printing & IT Solutions Catalog",
		"itemListElement": servicesList.map((service, idx) => ({
			"@type": "Offer",
			"itemOffered": { "@type": "Service", "name": service },
			"position": idx + 1,
		})),
	};
}

// 2. Workshop branch: Surabaya.
const workshopSurabayaSchema: Record<string, any> = {
	"@type": ["LocalBusiness", "ProfessionalService"],
	"@id": `${origin}/#workshop-surabaya`,
	"name": wsbyName,
	"url": origin,
	"parentOrganization": { "@id": `${origin}/#organization` },
	"address": {
		"@type": "PostalAddress",
		"streetAddress": wsbyAddr,
		"addressLocality": wsbyLoc,
		"addressRegion": wsbyReg,
		"postalCode": wsbyPost,
		"addressCountry": "ID",
	},
	"geo": { "@type": "GeoCoordinates", "latitude": wsbyLat, "longitude": wsbyLng },
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
			"opens": "08:00",
			"closes": "22:00",
		},
	],
};
if (orgPhone) workshopSurabayaSchema["telephone"] = orgPhone;

// 3. Workshop branch: Sidoarjo.
const workshopSidoarjoSchema: Record<string, any> = {
	"@type": ["LocalBusiness", "ProfessionalService"],
	"@id": `${origin}/#workshop-sidoarjo`,
	"name": wsidName,
	"url": origin,
	"parentOrganization": { "@id": `${origin}/#organization` },
	"address": {
		"@type": "PostalAddress",
		"streetAddress": wsidAddr,
		"addressLocality": wsidLoc,
		"addressRegion": wsidReg,
		"postalCode": wsidPost,
		"addressCountry": "ID",
	},
	"geo": { "@type": "GeoCoordinates", "latitude": wsidLat, "longitude": wsidLng },
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
			"opens": "08:00",
			"closes": "22:00",
		},
	],
};
if (orgPhone) workshopSidoarjoSchema["telephone"] = orgPhone;

// 4. Localized Service schema for service pages.
// NOTE: WebSite, WebPage, BreadcrumbList and Article/BlogPosting are owned by
// the @jdevalk SEO plugin, so they are intentionally NOT emitted here to avoid
// duplicate / competing structured data. This file owns Organization +
// workshop LocalBusiness + (on service pages) a Service node only.
const isHome = pathname === "/" || pathname === "";
const isServicePage =
	pathname.startsWith("/jasa-") || pathname.includes("service") || pathname.includes("software");

const graph: any[] = [organizationSchema, workshopSurabayaSchema, workshopSidoarjoSchema];

if (isServicePage && !isHome) {
	const serviceSchema: Record<string, any> = {
		"@type": "Service",
		"@id": `${currentUrl}/#service`,
		"name": pageTitle || orgName,
		"description": description || orgDesc,
		"provider": { "@id": `${origin}/#organization` },
		"areaServed": detectedCity
			? { "@type": "City", "name": detectedCity }
			: organizationSchema["areaServed"],
		"offers": {
			"@type": "Offer",
			"price": "50000",
			"priceCurrency": "IDR",
			"availability": "https://schema.org/InStock",
			"url": currentUrl,
		},
	};
	graph.push(serviceSchema);
}

const jsonLd = JSON.stringify({
	"@context": "https://schema.org",
	"@graph": graph,
});
---

<script type="application/ld+json" set:html={jsonLd} />
