---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import BookMockup from "../ui/BookMockup.astro";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs, formatAccentWords } from "../../utils/text";

type SplitBlock = Extract<PageContentBlock, { _type: "marketing_split" }>;
type Props = BlockComponentProps<SplitBlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, eyebrow, headline } = raw;
const image = raw.image ?? raw.imageUrl;
const image_caption = raw.image_caption ?? raw.imageCaption;
const image_first = raw.image_first ?? raw.imageFirst;
const rawFit = String(raw.image_fit ?? raw.imageFit ?? "").trim().toLowerCase();
const isSquareImageObj = typeof image === "object" && image !== null && image.width && image.height && image.width === image.height;
const isFullMedia =
	rawFit === "full" ||
	rawFit === "square" ||
	rawFit === "contain" ||
	rawFit === "1:1" ||
	(!rawFit && isSquareImageObj);

const paragraphs = toParagraphs(raw.body ?? "");
const points = (raw.points ?? "")
	.split("\n")
	.map((point: string) => point.trim())
	.filter(Boolean);
const ctaLabel = raw.cta_label ?? raw.ctaLabel;
const ctaUrl = raw.cta_url ?? raw.ctaUrl;
const cta =
	ctaLabel && ctaUrl
		? { label: ctaLabel, url: sanitizeHref(ctaUrl) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={[
		"band",
		"section",
		"split",
		{ "split--image-first": image_first, "split--text-only": !image },
	]}
>
	<div class="frame split__grid">
		<div>
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2 class="section-headline split__headline"><Fragment set:html={formatAccentWords(headline)} /></h2>
			{paragraphs.map((paragraph) => <p class="split__body">{paragraph}</p>)}
			{points.length > 0 && (
				<ul class="split__points" role="list">
					{points.map((point) => (
						<li>
							<span class="tick" aria-hidden="true">
								<Icon name="ph:check" />
							</span>
							{point}
						</li>
					))}
				</ul>
			)}
			{cta && (
				<a href={cta.url} class="text-link split__link">
					{cta.label}
					<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
				</a>
			)}
		</div>
		{(image || raw.show_mockup) && (
			image === "mockup" || raw.show_mockup ? (
				<div class="split__media settle">
					<BookMockup title={headline} eyebrow={eyebrow} />
				</div>
			) : (
				<figure class:list={["media", "settle", "split__media", { "split__media--full": isFullMedia }]}>
					<div class="media__img">
						{typeof image === "string" ? (
							<img src={image} alt={headline || "Deliverables"} loading="lazy" class:list={["w-full rounded-xl", isFullMedia ? "h-auto object-contain" : "h-full object-cover"]} />
						) : (
							<Image image={image} sizes="(max-width: 960px) 100vw, 600px" />
						)}
					</div>
					{image_caption && (
						<figcaption class="media-chip">
							{image_caption}
						</figcaption>
					)}
				</figure>
			)
		)}
	</div>
</section>

<style>
	.split__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(48px, 7vw, 112px);
		align-items: center;
	}

	.split--text-only .split__grid {
		grid-template-columns: minmax(0, 780px);
	}

	.eyebrow + .split__headline {
		margin-block-start: 18px;
	}

	.split__body {
		max-width: 46ch;
		margin-block-start: 20px;
		font-size: 17px;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.split__points {
		display: grid;
		gap: 14px;
		margin-block-start: 28px;
		list-style: none;
	}

	.split__points li {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		font-size: 15.5px;
		color: var(--color-text-secondary);
	}

	.split__link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-block-start: 28px;
	}

	.split__media {
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-xl);
		overflow: hidden;
		background: var(--color-fill);
	}
	.split__media--full {
		aspect-ratio: auto !important;
		background: transparent;
	}
	.split__media--full .media__img,
	.split__media--full :global(img),
	.split__media--full :global(picture) {
		height: auto !important;
		object-fit: contain !important;
	}
	@media (max-width: 640px) {
		.split__media:not(.split__media--full) {
			aspect-ratio: 16 / 9;
		}
	}

	.split--image-first .split__media {
		order: -1;
	}

	@media (max-width: 960px) {
		.split__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.split--image-first .split__media {
			order: 0;
		}
	}
</style>
