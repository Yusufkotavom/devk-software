---
import { Icon } from "astro-iconset/components";
import { getEmDashCollection, getTermsForEntries } from "emdash";
import type { BlockComponentProps } from "emdash/ui";
import type { PageContentBlock } from "../../../emdash-env";
import PostCard from "../PostCard.astro";
import { buildOgImageUrl } from "../../lib/og/url";

type FeedBlock = Extract<PageContentBlock, { _type: "marketing_feed" }>;
type Props = BlockComponentProps<FeedBlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, eyebrow, headline, subheadline } = raw;

// 1. Support posts, products, projects, and pages
const rawSource = String(
	raw.collection ?? raw.source ?? raw.content_type ?? raw.contentType ?? raw.type ?? "posts"
).trim().toLowerCase();

const collection = (rawSource === "products" || rawSource === "product" || rawSource === "produk")
	? "products"
	: (rawSource === "projects" || rawSource === "project" || rawSource === "proyek" || rawSource === "portfolio" || rawSource === "case-studies" || rawSource === "case_studies")
	? "projects"
	: (rawSource === "pages" || rawSource === "page")
	? "pages"
	: "posts";

// 2. Aspect ratio: "1:1" | "16:9" | "auto"
const rawAspect = String(
	raw.aspect_ratio ?? raw.aspectRatio ?? raw.thumb_ratio ?? raw.thumb_aspect ?? raw.thumbRatio ?? raw.ratio ?? ""
).trim().toLowerCase();

const thumbAspectRatio: "1:1" | "16:9" | "auto" =
	(rawAspect === "1:1" || rawAspect === "1*1" || rawAspect === "square" || rawAspect === "1/1" || rawAspect === "1-1")
		? "1:1"
		: (rawAspect === "16:9" || rawAspect === "16*9" || rawAspect === "video" || rawAspect === "16/9" || rawAspect === "16-9" || rawAspect === "wide")
		? "16:9"
		: "auto";

const mode = String(raw.mode ?? "latest"); // latest | tag | category | random | manual
const layout = String(raw.layout ?? "grid"); // grid | list | slide
const limit = Math.max(1, Math.min(24, Number(raw.limit ?? 6) || 6));
const term = String(raw.term ?? "").trim();
const manualIds = String(raw.manual_ids ?? raw.manualIds ?? "")
	.split(/[\n,]+/)
	.map((id) => id.trim())
	.filter(Boolean);

const ctaLabel = raw.cta_label ?? raw.ctaLabel;
const ctaUrl = raw.cta_url ?? raw.ctaUrl ?? (
	collection === "products" ? "/products" : collection === "projects" ? "/projects" : collection === "posts" ? "/posts" : undefined
);

const isPosts = collection === "posts";
const origin = (Astro.site ?? Astro.url.origin).toString().replace(/\/$/, "");

const where =
	mode === "tag" ? { tag: term } : mode === "category" ? { category: term } : undefined;

const orderBy = isPosts
	? { published_at: "desc" }
	: { created_at: "desc" };

// Random pulls a wider window then shuffles deterministically per current pathname
// so every generated location page links to a stable, distinct ring of sibling pages.
const fetchLimit =
	mode === "manual" ? 100 : mode === "random" ? (collection === "pages" ? 450 : Math.max(limit * 4, 30)) : limit;

let entries: any[] = [];
try {
	const res = await getEmDashCollection(collection as any, {
		where,
		orderBy: orderBy as any,
		limit: fetchLimit,
	});
	entries = res.entries ?? [];
	if (Astro.cache?.enabled && res.cacheHint) Astro.cache.set(res.cacheHint);
} catch {
	entries = [];
}

const currentSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, "");
entries = entries.filter((entry) => String(entry.id) !== currentSlug && `posts/${entry.id}` !== currentSlug);

if (term && mode !== "tag" && mode !== "category" && mode !== "by_tag" && mode !== "by_category") {
	const needle = term.toLowerCase();
	const filtered = entries.filter(
		(entry) =>
			String(entry.id || "").toLowerCase().includes(needle) ||
			String(entry.data?.title || "").toLowerCase().includes(needle),
	);
	if (filtered.length > 0) entries = filtered;
} else if (collection === "pages" && !term) {
	// Default for pages feed in pSEO: prioritize service/city pages over utility pages
	const cetakPages = entries.filter((entry) => String(entry.id || "").startsWith("jasa-cetak-buku-") || String(entry.id || "").startsWith("percetakan/"));
	if (cetakPages.length >= limit) entries = cetakPages;
}

if (mode === "random") {
	// Deterministic hash of current URL path + query so links are stable for SEO crawlers
	const seedStr = `${Astro.url.pathname}${Astro.url.search}`;
	let seed = 2166136261;
	for (let k = 0; k < seedStr.length; k++) {
		seed ^= seedStr.charCodeAt(k);
		seed = Math.imul(seed, 16777619);
	}
	for (let i = entries.length - 1; i > 0; i--) {
		seed ^= seed << 13;
		seed ^= seed >>> 17;
		seed ^= seed << 5;
		const j = Math.abs(seed) % (i + 1);
		[entries[i], entries[j]] = [entries[j], entries[i]];
	}
} else if (mode === "manual") {
	const byId = new Map(entries.map((entry) => [String(entry.id), entry]));
	entries = manualIds.map((id) => byId.get(id)).filter(Boolean);
}

entries = entries.slice(0, limit);

// Tags are only meaningful for posts, and only when we actually have entries.
let tagsByEntry = new Map<string, Array<{ slug: string; label: string }>>();
if (isPosts && entries.length > 0) {
	try {
		tagsByEntry = await getTermsForEntries(
			"posts",
			entries.map((entry) => entry.data.id),
			"tag",
		);
	} catch {
		tagsByEntry = new Map();
	}
}
---

<section id={anchor_id || undefined} class:list={["band", "section", "feed-section", `feed-section--${layout}`, { "feed-section--square": thumbAspectRatio === "1:1", "feed-section--16-9": thumbAspectRatio === "16:9" }]}>
	<div class="frame">
		{
			(eyebrow || headline || subheadline || (ctaLabel && ctaUrl)) && (
				<div class="feed__head">
					<div>
						{eyebrow && <p class="eyebrow">{eyebrow}</p>}
						{headline && <h2 class="section-headline feed__headline">{headline}</h2>}
						{subheadline && <p class="feed__subheadline">{subheadline}</p>}
					</div>
					{ctaLabel && ctaUrl && (
						<a href={ctaUrl} class="arrow-link feed__all">
							{ctaLabel}
							<Icon name="ph:arrow-right" aria-hidden="true" />
						</a>
					)}
				</div>
			)
		}

		{
			entries.length === 0 ? (
				<p class="feed__empty">Belum ada konten untuk ditampilkan.</p>
			) : layout === "list" ? (
				<ol class="feed__list" role="list">
					{entries.map((entry) => (
						<li>
							<PostCard
								post={entry}
								collection={collection}
								tags={tagsByEntry.get(entry.data?.id) ?? []}
								variant="row"
								site={Astro.site ?? null}
								aspectRatio={thumbAspectRatio}
							/>
						</li>
					))}
				</ol>
			) : layout === "slide" ? (
				<div data-slider>
					<ul class="feed__track slider__track" data-track role="list">
						{entries.map((entry) => (
							<li class="feed__slide">
								<PostCard
									post={entry}
									collection={collection}
									tags={tagsByEntry.get(entry.data?.id) ?? []}
									variant="card"
									site={Astro.site ?? null}
									aspectRatio={thumbAspectRatio}
								/>
							</li>
						))}
					</ul>
					<div class="slider__dots feed__dots" data-dots>
						{entries.map(() => (
							<button type="button" class="slider__dot" aria-label="Go to slide" />
						))}
					</div>
				</div>
			) : (
				<div class="post-grid">
					{entries.map((entry) => (
						<PostCard
							post={entry}
							collection={collection}
							tags={tagsByEntry.get(entry.data?.id) ?? []}
							variant="card"
							site={Astro.site ?? null}
							aspectRatio={thumbAspectRatio}
						/>
					))}
				</div>
			)
		}
	</div>
</section>

<script>
	import "../../scripts/slider";
</script>

<style>
	.feed__head {
		display: flex;
		align-items: flex-end;
		align-items: last baseline;
		justify-content: space-between;
		gap: 24px;
		margin-block-end: clamp(24px, 3vw, 40px);
	}

	.feed__headline {
		max-width: 40ch;
	}

	.feed__subheadline {
		max-width: 60ch;
		margin-block-start: 12px;
		font-size: 17px;
		line-height: 1.55;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.feed__all {
		flex: none;
	}

	.feed__empty {
		padding: 48px 0;
		color: var(--color-muted);
	}

	.feed__list {
		list-style: none;
	}

	.feed__list > li + li {
		border-block-start: 1px solid var(--color-border);
	}

	/* Slide layout reuses the slider track styling but keeps its own sizing. */
	.feed__track {
		display: flex;
		gap: 16px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		scrollbar-width: none;
	}

	.feed__track::-webkit-scrollbar {
		display: none;
	}

	.feed__slide {
		flex: none;
		width: clamp(260px, 32%, 380px);
		scroll-snap-align: start;
	}

	.feed__dots {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-block-start: 20px;
	}

	@media (max-width: 640px) {
		.feed__slide {
			width: 82%;
		}
	}
</style>
