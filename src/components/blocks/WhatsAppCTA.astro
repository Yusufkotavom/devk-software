---
import { getWhatsAppSettings, buildWhatsAppHref } from "../../utils/whatsapp";

interface Props {
	headline?: string;
	body?: string;
	label?: string;
	custom_message?: string;
	variant?: "banner" | "card" | "inline";
	anchor_id?: string;
}

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const {
	headline,
	body,
	label,
	custom_message,
	variant = "card",
	anchor_id,
} = raw;

const setting = await getWhatsAppSettings();
const currentUrl = Astro.url.href;

const waUrl = buildWhatsAppHref(setting, {
	pageUrl: currentUrl,
	context: "block",
	customMessage: custom_message,
});

const buttonLabel = label || setting?.product_cta_label || "Chat via WhatsApp";
const displayHeadline = headline || "Punya Pertanyaan atau Kebutuhan Khusus?";
const displayBody = body || "Tim kami siap membantu konsultasi spesifikasi, custom order, atau penawaran harga terbaik.";
---

<section class="band section wa-block-section" id={anchor_id || undefined}>
	<div class="frame">
		<div class:list={["wa-block", `wa-block--${variant}`]}>
			<div class="wa-block__content">
				<div class="wa-block__badge">
					<span class="wa-block__badge-dot"></span>
					<span>WhatsApp Chat</span>
				</div>
				<h2 class="wa-block__headline">{displayHeadline}</h2>
				<p class="wa-block__body">{displayBody}</p>
			</div>
			<div class="wa-block__action">
				<a
					href={waUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="wa-block__btn"
				>
					<svg
						class="wa-block__btn-icon"
						viewBox="0 0 24 24"
						fill="currentColor"
						width="20"
						height="20"
					>
						<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.69C7.02 10.9 7.9 12.07 8.02 12.23C8.14 12.39 9.73 14.85 12.18 15.91C12.76 16.16 13.22 16.31 13.57 16.42C14.16 16.61 14.7 16.58 15.12 16.52C15.6 16.45 16.58 15.92 16.79 15.34C16.99 14.76 16.99 14.26 16.93 14.15C16.87 14.05 16.71 13.99 16.47 13.87C16.22 13.75 15.01 13.15 14.78 13.07C14.56 12.99 14.4 12.95 14.23 13.19C14.07 13.44 13.6 14.01 13.46 14.17C13.32 14.33 13.18 14.35 12.94 14.23C12.69 14.11 11.9 13.85 10.96 13.01C10.23 12.36 9.73 11.55 9.59 11.31C9.45 11.07 9.57 10.94 9.7 10.82C9.81 10.71 9.95 10.53 10.07 10.39C10.19 10.25 10.23 10.15 10.31 9.99C10.39 9.83 10.35 9.68 10.29 9.56C10.23 9.44 9.76 8.24 9.55 7.74C9.36 7.26 9.16 7.32 9.01 7.31C8.87 7.31 8.7 7.33 8.53 7.33Z"/>
					</svg>
					<span>{buttonLabel}</span>
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.wa-block-section {
		padding-block: var(--space-4, 2rem);
	}
	.wa-block {
		background: var(--surface-2, #18181b);
		border: 1px solid var(--border-color, #27272a);
		border-radius: var(--radius-lg, 1rem);
		padding: clamp(1.5rem, 4vw, 2.5rem);
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: flex-start;
		box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.2);
		position: relative;
		overflow: hidden;
	}
	@media (min-width: 768px) {
		.wa-block {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
	.wa-block--banner {
		background: linear-gradient(135deg, rgba(37, 211, 102, 0.1) 0%, rgba(24, 24, 27, 0.95) 100%);
		border-color: rgba(37, 211, 102, 0.3);
	}
	.wa-block__badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.75rem;
		border-radius: 9999px;
		background: rgba(37, 211, 102, 0.12);
		color: #25d366;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 0.75rem;
	}
	.wa-block__badge-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #25d366;
		box-shadow: 0 0 8px #25d366;
	}
	.wa-block__headline {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		font-weight: 700;
		color: var(--text-color, #fafafa);
		line-height: 1.25;
		margin: 0 0 0.5rem 0;
	}
	.wa-block__body {
		font-size: 0.95rem;
		color: var(--text-muted, #a1a1aa);
		line-height: 1.5;
		margin: 0;
		max-width: 48ch;
	}
	.wa-block__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
		padding: 0.875rem 1.75rem;
		border-radius: var(--radius-md, 0.75rem);
		background: #25d366;
		color: #ffffff !important;
		font-size: 0.95rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
		transition: all 0.2s ease;
	}
	.wa-block__btn:hover {
		background: #20ba59;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
	}
	.wa-block__btn-icon {
		flex-shrink: 0;
	}
</style>
