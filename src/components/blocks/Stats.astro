---
import type { BlockComponentProps } from "emdash/ui";
import ScaleIn from "@astroanimate/core/ScaleIn";
import CountUp from "@astroanimate/core/CountUp";
import type { PageContentBlock } from "../../../emdash-env";
import { toParagraphs } from "../../utils/text";

type StatsBlock = Extract<PageContentBlock, { _type: "marketing_stats" }>;
type Props = BlockComponentProps<StatsBlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, headline, subheadline } = raw;
const stats = Array.isArray(raw.stats) ? raw.stats : [];
const panel = String(raw.panel ?? "none"); // none | sunken | ink
const hasPanel = panel === "sunken" || panel === "ink";

function parseStatValue(val: string) {
	if (!val) return null;
	const str = String(val).trim();
	const match = str.match(/^([^\d]*)([\d,.]+)(.*)$/);
	if (!match) return null;
	const prefix = match[1] ?? "";
	const numStr = match[2].replace(/,/g, "");
	const num = parseFloat(numStr);
	if (isNaN(num)) return null;
	const suffix = match[3] ?? "";
	const decimals = (numStr.split(".")[1] || "").length;
	return { prefix, num, suffix, decimals };
}
---

<section id={anchor_id || undefined} class="band section stats-section">
	<div class="frame">
		<div class:list={hasPanel ? ["sheet", panel === "ink" ? "sheet--night" : "sheet--sunken"] : []}>
			<div class:list={hasPanel ? "sheet-body" : []}>
				{
					(headline || subheadline) && (
						<header class="section-header">
							{headline && <h2 class="section-headline">{headline}</h2>}
							{subheadline && <p class="section-subheadline">{subheadline}</p>}
						</header>
					)
				}
				<dl class="stats__list">
					{stats.map((stat: any, idx: number) => (
						<ScaleIn
							as="div"
							class="stats__item"
							duration={700}
							delay={idx * 90}
							initialScale={0.88}
							enhance={true}
							easing="cubic-bezier(0.16, 1, 0.3, 1)"
						>
							<dt class="stats__label">{stat.label}</dt>
							<dd class="stats__body">
								<span class="stats__value">
									{(() => {
										const parsed = parseStatValue(stat.value);
										if (parsed) {
											return (
												<CountUp
													value={parsed.num}
													prefix={parsed.prefix}
													suffix={parsed.suffix}
													decimals={parsed.decimals}
													duration={1800}
													enhance={true}
													textColor="inherit"
													fontSize="inherit"
													fontFamily="inherit"
												/>
											);
										}
										return stat.value;
									})()}
								</span>
								{toParagraphs(stat.description ?? "").map((p: string) => (
									<span class="stats__note">{p}</span>
								))}
							</dd>
						</ScaleIn>
					))}
				</dl>
			</div>
		</div>
	</div>
</section>

<style>
	.stats__headline {
		max-width: 30ch;
		margin-block-end: clamp(32px, 4vw, 56px);
	}

	.stats__list {
		--stats-column-gap: 32px;
		display: grid;
		grid-template-columns: repeat(
			auto-fit,
			minmax(min(100%, max(180px, (100% - 3 * var(--stats-column-gap)) / 4)), 1fr)
		);
		gap: 36px var(--stats-column-gap);
	}

	.stats__item {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.stats__label {
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.stats__body {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: 0;
	}

	.stats__value {
		font-family: var(--font-heading);
		font-size: clamp(36px, 4vw, 56px);
		font-weight: var(--font-weight-display);
		font-variant-numeric: tabular-nums;
		line-height: 1;
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	.stats__note {
		max-width: 26ch;
		font-size: 14.5px;
		line-height: 1.5;
		color: var(--color-text-secondary);
		text-wrap: pretty;
	}

	.sheet--night .stats__label,
	.sheet--night .stats__note {
		color: var(--color-on-night-muted);
	}

	@media (max-width: 960px) {
		.stats__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
