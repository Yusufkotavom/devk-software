---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import { Image, type BlockComponentProps } from "emdash/ui";
import BookMockup from "../ui/BookMockup.astro";
import BrandOrbit from "../ui/BrandOrbit.astro";
import FadeInText from "@astroanimate/core/FadeInText";
import type { PageContentBlock } from "../../../emdash-env";
import { formatAccentWords } from "../../utils/text";

type HeroBlock = Extract<PageContentBlock, { _type: "marketing_hero" }>;
type Props = BlockComponentProps<HeroBlock>;

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, eyebrow, headline, subheadline, centered } = raw;
const image = raw.image ?? raw.imageUrl;
const image_caption = raw.image_caption ?? raw.imageCaption;
const rawFit = String(raw.image_fit ?? raw.imageFit ?? "").trim().toLowerCase();
const isOrbit = String(image ?? "").trim().toLowerCase() === "orbit" || raw.brand_orbit === true;
const isSquareImageObj = typeof image === "object" && image !== null && image.width && image.height && image.width === image.height;
const isFullMedia =
	rawFit === "full" ||
	rawFit === "square" ||
	rawFit === "contain" ||
	rawFit === "1:1" ||
	(!rawFit && isSquareImageObj);

const eyebrowUrl = (raw.eyebrow_url ?? raw.eyebrowUrl) ? sanitizeHref(raw.eyebrow_url ?? raw.eyebrowUrl) : undefined;
const primaryCtaLabel = raw.primary_cta_label ?? raw.primaryCtaLabel;
const primaryCtaUrl = raw.primary_cta_url ?? raw.primaryCtaUrl;
const primaryCta =
	primaryCtaLabel && primaryCtaUrl
		? { label: primaryCtaLabel, url: sanitizeHref(primaryCtaUrl) }
		: undefined;
const secondaryCtaLabel = raw.secondary_cta_label ?? raw.secondaryCtaLabel;
const secondaryCtaUrl = raw.secondary_cta_url ?? raw.secondaryCtaUrl;
const secondaryCta =
	secondaryCtaLabel && secondaryCtaUrl
		? { label: secondaryCtaLabel, url: sanitizeHref(secondaryCtaUrl) }
		: undefined;
---

<section
	id={anchor_id || undefined}
	class:list={["hero", "bg-grid-dots", { "hero--centered": centered, "hero--orbit": isOrbit && !centered }]}
>
	<div class="frame">
		{
			eyebrow && eyebrowUrl && (
				<a href={eyebrowUrl} class="hero__announce rise">
					{eyebrow}
					<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
				</a>
			)
		}
		{eyebrow && !eyebrowUrl && <p class="hero__announce rise">{eyebrow}</p>}
		<FadeInText as="h1" class="hero__headline rise" duration={1.2} distance={24} enhance={true} easing="cubic-bezier(0.16, 1, 0.3, 1)">
			<Fragment set:html={formatAccentWords(headline)} />
		</FadeInText>
		{
			(subheadline || primaryCta || secondaryCta) && (
				<div class="hero__row rise">
					{subheadline && <p class="lead hero__lead">{subheadline}</p>}
					{(primaryCta || secondaryCta) && (
						<div class="actions">
							{primaryCta && (
								<a href={primaryCta.url} class="btn btn-primary btn-lg">
									{primaryCta.label}
									<Icon name="ph:arrow-right" aria-hidden="true" class="arrow" />
								</a>
							)}
							{secondaryCta && (
								<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
									{secondaryCta.label}
								</a>
							)}
						</div>
					)}
				</div>
			)
		}
	</div>
	{
		(isOrbit || image || raw.show_mockup) && (
			<div class="frame hero__media-wrap">
				{isOrbit ? (
					<div class="hero__orbit">
						<BrandOrbit centerLabel={raw.brand_name || "Kotacom"} />
					</div>
				) : image === "mockup" || raw.show_mockup ? (
					<BookMockup title={headline} eyebrow={eyebrow} />
				) : (
					<figure class:list={["media", "hero__media", "settle", { "hero__media--full": isFullMedia }]}>
						<div class="media__img">
							{typeof image === "string" ? (
								<img src={image} alt={headline || "Hero"} class:list={["w-full rounded-xl", isFullMedia ? "h-auto object-contain" : "h-full object-cover"]} />
							) : (
								<Image
									image={image}
									priority
									sizes={isFullMedia ? "(min-width: 768px) 640px, 92vw" : "(min-width: 1264px) 1136px, 92vw"}
								/>
							)}
						</div>
						{image_caption && (
							<figcaption class="media-chip">
								{image_caption}
							</figcaption>
						)}
					</figure>
				)}
			</div>
		)
	}
</section>

<style>
	.hero {
		padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) clamp(2rem, 1.5rem + 2vw, 3rem);
	}

	.hero__announce {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 13.5px;
		line-height: 1.35;
		color: var(--color-text-secondary);
		padding: 0;
		background: transparent;
		border: none;
		box-shadow: none;
	}

	.hero__announce::before {
		content: "";
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background-color: var(--color-brand-accent);
		box-shadow: 0 0 0 0 var(--color-brand-accent-glow);
		animation: pulse-dot 2.2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
		flex-shrink: 0;
	}

	.hero__announce :global(.arrow) {
		flex: none;
		color: var(--color-muted);
	}

	a.hero__announce:hover {
		box-shadow: var(--shadow-card-hover);
	}

	.hero__headline {
		--rise-index: 1;
		max-width: 16ch;
		font-size: var(--font-size-hero, clamp(2rem, 1.6rem + 2vw, 3.75rem));
		line-height: 1.08;
		letter-spacing: var(--tracking-tight);
	}

	@media (max-width: 640px) {
		.hero__headline {
			font-size: clamp(1.85rem, 1.5rem + 1.8vw, 2.25rem);
			line-height: 1.15;
			max-width: 100%;
		}
	}

	.hero__announce + .hero__headline {
		margin-block-start: 24px;
	}

	.hero__row {
		--rise-index: 2;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 24px;
		margin-block-start: 28px;
	}

	.hero--centered .hero__row {
		align-items: center;
	}

	.hero__lead {
		max-width: 50ch;
		font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
		line-height: var(--leading-normal);
		color: var(--color-text-secondary);
	}

	.hero__media-wrap {
		margin-block-start: clamp(36px, 4.5vw, 64px);
	}

	/* Hero dengan orbit brand: teks di kiri, visual ekosistem di kanan.
	   Grid-nya sendiri memakai lebar frame supaya sejajar dengan header. */
	.hero--orbit {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
		align-items: center;
		gap: clamp(24px, 3.2vw, 52px);
		width: var(--frame-width);
		margin-inline: auto;
		padding-inline: var(--frame-padding);
	}

	.hero--orbit > .frame {
		width: auto;
		margin-inline: 0;
		padding-inline: 0;
	}

	.hero--orbit > .hero__media-wrap {
		margin-block-start: 0;
	}

	.hero--orbit .hero__headline {
		max-width: 17ch;
	}

	.hero__orbit {
		position: relative;
		width: 100%;
		max-width: 505px;
		margin-inline-start: auto;
	}

	@media (max-width: 1000px) {
		.hero--orbit {
			grid-template-columns: minmax(0, 1fr);
			gap: 0;
			padding-inline: 0;
		}

		.hero--orbit > .frame {
			width: var(--frame-width);
			margin-inline: auto;
			padding-inline: var(--frame-padding);
		}

		.hero--orbit > .hero__media-wrap {
			margin-block-start: clamp(28px, 5vw, 40px);
		}

		.hero--orbit .hero__headline {
			max-width: 100%;
		}

		.hero__orbit {
			margin-inline: auto;
		}
	}

	.hero__media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-xl);
		background: var(--color-fill);
	}

	.hero__media--full {
		aspect-ratio: auto !important;
		max-width: min(100%, 640px);
		margin-inline: auto;
		background: transparent;
	}

	.hero__media--full .media__img,
	.hero__media--full :global(img),
	.hero__media--full :global(picture) {
		height: auto !important;
		object-fit: contain !important;
	}

	.hero__media::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		outline: 1px solid var(--color-media-outline);
		pointer-events: none;
	}

	.hero--centered .frame {
		text-align: center;
	}

	.hero--centered .hero__headline {
		max-width: 20ch;
		margin-inline: auto;
		font-size: var(--font-size-hero, clamp(2.75rem, 2.2rem + 4vw, 5rem));
	}

	.hero--centered .hero__row {
		grid-template-columns: minmax(0, 1fr);
		justify-items: center;
	}

	.hero--centered .actions {
		justify-content: center;
	}

	@media (max-width: 960px) {
		.hero__row {
			grid-template-columns: minmax(0, 1fr);
		}

		.hero__media:not(.hero__media--full) {
			aspect-ratio: 16 / 9;
		}
	}

	@media (max-width: 640px) {
		.hero__media:not(.hero__media--full) {
			aspect-ratio: 16 / 9;
		}
	}
</style>
