---
import { marked } from "marked";

interface Props {
	value?: any;
	node?: any;
}

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const type = raw._type || "";

let renderedMarkdownHtml = "";
if (type === "legacy-rich-content" && raw.contentRaw) {
	if (raw.contentRaw.includes("<section") || raw.contentFormat === "html") {
		renderedMarkdownHtml = raw.contentRaw;
	} else {
		// Clean up custom tags like <Alert type="..."> or <Blockquote> if present
		let processed = raw.contentRaw
			.replace(/<Alert\s+type="([^"]*)">([\s\S]*?)<\/Alert>/gi, (_match: string, alertType: string, inner: string) => {
				return `\n\n> **[${alertType.toUpperCase()}]**\n> ${inner.trim().replace(/\n/g, '\n> ')}\n\n`;
			})
			.replace(/<Blockquote>([\s\S]*?)<\/Blockquote>/gi, (_match: string, inner: string) => {
				return `\n\n> ${inner.trim().replace(/\n/g, '\n> ')}\n\n`;
			});
		renderedMarkdownHtml = marked.parse(processed, { gfm: true, breaks: false }) as string;
	}
}
---

{type === "legacy-rich-content" && (
	raw.contentRaw && (raw.contentRaw.includes("<section") || raw.contentFormat === "html") ? (
		<div class="scraped-page-container w-full" set:html={renderedMarkdownHtml} />
	) : (
		<section class="section py-4">
			<div class="frame max-w-4xl mx-auto">
				{renderedMarkdownHtml ? (
					<div class="prose max-w-none text-foreground leading-relaxed" set:html={renderedMarkdownHtml} />
				) : (
					<p class="text-muted">{raw.excerpt}</p>
				)}
			</div>
		</section>
	)
)}

{type === "stats-hero-block" && (
	<section class="section py-12 bg-surface border-b border-border/40">
		<div class="frame max-w-5xl mx-auto text-center">
			{raw.eyebrow && (
				<div class="inline-block px-3 py-1 mb-4 text-xs font-semibold uppercase tracking-wider bg-brand/10 text-brand rounded-full">
					{raw.eyebrow}
				</div>
			)}
			{raw.title && (
				<h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-4">
					{raw.title}
				</h1>
			)}
			{raw.description && (
				<p class="text-lg sm:text-xl text-muted max-w-3xl mx-auto mb-8 leading-relaxed">
					{raw.description}
				</p>
			)}
			{raw.links && raw.links.length > 0 && (
				<div class="flex flex-wrap justify-center gap-4">
					{raw.links.map((link: any) => (
						<a
							href={link.href || "https://wa.me/6285799520350"}
							target={link.isExternal ? "_blank" : undefined}
							rel={link.isExternal ? "noopener noreferrer" : undefined}
							class={link.buttonVariant === "default" || !link.buttonVariant ? "btn btn-primary btn-lg" : "btn btn-secondary btn-lg"}
						>
							{link.title || "Konsultasi Sekarang"}
						</a>
					))}
				</div>
			)}
		</div>
	</section>
)}

{type === "section-header" && (
	<div class="frame max-w-4xl mx-auto text-center py-8">
		{raw.eyebrow && <span class="eyebrow block mb-2">{raw.eyebrow}</span>}
