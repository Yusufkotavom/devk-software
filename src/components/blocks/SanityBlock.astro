<style>
	.scraped-page-container {
		width: 100%;
		max-width: var(--wide-width, 1200px);
		margin-inline: auto;
		padding-inline: var(--gutter, 1.5rem);
		padding-block: var(--section-space, 3rem);
		color: var(--color-text);
	}
	.scraped-page-container :global(section) {
		margin-block: 2.5rem;
	}
	.scraped-page-container :global(h1),
	.scraped-page-container :global(h2),
	.scraped-page-container :global(h3) {
		color: var(--color-text);
		font-family: var(--font-display, inherit);
		font-weight: 700;
		line-height: 1.25;
		margin-bottom: 1rem;
	}
	.scraped-page-container :global(h1) { font-size: clamp(2rem, 1.5rem + 2vw, 3rem); }
	.scraped-page-container :global(h2) { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem); }
	.scraped-page-container :global(h3) { font-size: 1.25rem; }
	.scraped-page-container :global(p) {
		color: var(--color-muted);
		line-height: 1.65;
		margin-bottom: 1rem;
	}
	.scraped-page-container :global(.lead) {
		font-size: 1.125rem;
		color: var(--color-text-secondary);
	}
	.scraped-page-container :global(a) {
		color: var(--color-brand);
		text-decoration: none;
	}
	.scraped-page-container :global(a[href*="wa.me"]),
	.scraped-page-container :global(.btn) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius-full, 9999px);
		font-weight: 600;
		background: var(--color-brand);
		color: var(--color-on-brand);
		transition: opacity 0.2s;
	}
	.scraped-page-container :global(.grid) {
		display: grid;
		gap: 1.5rem;
	}
	.scraped-page-container :global(.card),
	.scraped-page-container :global([class*="rounded-"]) {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl, 20px);
		padding: 1.5rem;
	}
</style>
