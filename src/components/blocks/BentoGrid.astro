---
import { Icon } from "astro-iconset/components";
import { sanitizeHref } from "emdash";
import ScaleIn from "@astroanimate/core/ScaleIn";
import FadeInText from "@astroanimate/core/FadeInText";

interface BentoItem {
	title: string;
	description: string;
	tag?: string;
	col_span?: "1" | "2" | "3";
	row_span?: "1" | "2";
	icon?: string;
	image_url?: string;
	link_url?: string;
	link_label?: string;
	badge?: string;
	code_snippet?: string;
}

const raw = (Astro.props as any).node ?? (Astro.props as any).value ?? Astro.props ?? {};
const { anchor_id, eyebrow, headline = "Arsitektur Modern untuk Skala Tanpa Batas", subheadline = "Semua yang Anda butuhkan untuk membangun, meluncurkan, dan menskalakan platform digital Anda." } = raw;
const rawItems: BentoItem[] = Array.isArray(raw.items) && raw.items.length > 0 ? raw.items : [
	{
		title: "Performa Kelas Dunia",
		description: "Waktu respon sub-100ms dengan rendering server native dan caching cerdas pada setiap endpoint.",
		tag: "SPEED",
		icon: "rocket",
		col_span: "2",
		row_span: "1",
		link_url: "/posts"
	},
	{
		title: "API-First & Headless",
		description: "Data terpusat dengan akses fleksibel melalui REST API, webhook otomatis, dan SDK modern.",
		tag: "ARCHITECTURE",
		icon: "code",
		col_span: "1",
		row_span: "1",
		code_snippet: "curl -X GET https://software.devk.my.id/api/products"
	},
	{
		title: "Keamanan Enterprise",
		description: "Isolasi container Docker Swarm dan proteksi edge security melindungi seluruh transaksi pengguna.",
		tag: "SECURITY",
		icon: "shield",
		col_span: "1",
		row_span: "1"
	},
	{
		title: "Integrasi WhatsApp Sentral",
		description: "Hubungkan penjualan, customer support, dan notifikasi otomatis langsung ke nomor WhatsApp bisnis Anda.",
		tag: "CONVERSION",
		icon: "sparkle",
		col_span: "2",
		row_span: "1",
		link_url: "/products"
	}
];
const items: BentoItem[] = rawItems;

const iconMap: Record<string, string> = {
	zap: "ph:lightning",
	shield: "ph:shield-check",
	users: "ph:users-three",
	chart: "ph:chart-bar",
	code: "ph:code",
	globe: "ph:globe",
	sparkle: "ph:sparkle",
	cpu: "ph:cpu",
	database: "ph:database",
	rocket: "ph:rocket",
	lock: "ph:lock",
	check: "ph:check-circle",
};
---

<section id={anchor_id || undefined} class="band section bento-section">
	<div class="frame">
		<header class="section-header">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			{headline && (
				<h2 class="section-headline">
					<FadeInText text={headline} duration={0.8} once={true} />
					{subheadline && " "}
					{subheadline && <span class="section-headline__muted">{subheadline}</span>}
				</h2>
			)}
		</header>

		<div class="bento-grid">
			{
				items.map((item, idx) => {
					const colSpan = item.col_span || "1";
					const rowSpan = item.row_span || "1";
					const rawIcon = String(item.icon ?? "").trim();
					const iconName = iconMap[rawIcon] || (rawIcon.startsWith("ph:") ? rawIcon : rawIcon ? `ph:${rawIcon}` : "ph:sparkle");
					const cleanUrl = item.link_url ? sanitizeHref(item.link_url) : null;

					return (
						<ScaleIn
							as="div"
							class:list={[
								"bento-card",
								`bento-card--col-${colSpan}`,
								`bento-card--row-${rowSpan}`,
							]}
							duration={0.8}
							delay={idx * 0.08}
							initialScale={0.94}
							enhance={true}
						>
							<div class="bento-card__inner">
								<div class="bento-card__header">
									{item.tag && <span class="bento-card__tag">{item.tag}</span>}
									{item.badge && <span class="bento-card__badge">{item.badge}</span>}
									<span class="bento-card__icon">
										<Icon name={iconName} />
									</span>
								</div>

								{item.image_url && (
									<div class="bento-card__media">
										<img src={item.image_url} alt={item.title} class="bento-card__img" loading="lazy" />
									</div>
								)}

								{item.code_snippet && (
									<div class="bento-card__code">
										<div class="bento-card__code-bar">
											<span class="dot dot--red"></span>
											<span class="dot dot--yellow"></span>
											<span class="dot dot--green"></span>
										</div>
										<pre><code>{item.code_snippet}</code></pre>
									</div>
								)}

								<div class="bento-card__content">
									<h3 class="bento-card__title">{item.title}</h3>
									<p class="bento-card__desc">{item.description}</p>
								</div>

								{cleanUrl && (
									<div class="bento-card__footer">
										<a href={cleanUrl} class="bento-card__link">
											<span>{item.link_label || "Pelajari Lebih Lanjut"}</span>
											<Icon name="ph:arrow-right" class="arrow" />
										</a>
									</div>
								)}
							</div>
						</ScaleIn>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.bento-section {
		padding-block: clamp(3rem, 5vw, 6rem);
	}
	.section-header {
		margin-block-end: clamp(2rem, 3.5vw, 3.5rem);
		max-width: 65ch;
	}
	.bento-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 1.25rem;
	}
	@media (min-width: 768px) {
		.bento-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.5rem;
		}
	}

	.bento-card {
		background: var(--surface-2, #18181b);
		border: 1px solid var(--border-color, #27272a);
		border-radius: var(--radius-lg, 1rem);
		overflow: hidden;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.bento-card::after {
		content: "+";
		position: absolute;
		top: 6px;
		right: 8px;
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		line-height: 1;
		color: var(--color-brand-accent);
		opacity: 0.35;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.bento-card:hover::after {
		opacity: 0.9;
	}

	.bento-card:hover {
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
		box-shadow: 0 12px 30px -10px rgba(0, 0, 0, 0.5);
	}

	@media (min-width: 768px) {
		.bento-card--col-2 {
			grid-column: span 2;
		}
		.bento-card--col-3 {
			grid-column: span 3;
		}
		.bento-card--row-2 {
			grid-row: span 2;
		}
	}

	.bento-card__inner {
		padding: clamp(1.5rem, 2.5vw, 2rem);
		display: flex;
		flex-direction: column;
		height: 100%;
		gap: 1rem;
	}

	.bento-card__header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		justify-content: flex-start;
	}
	.bento-card__tag {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--text-color, #fafafa);
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.12);
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
	}
	.bento-card__badge {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--text-muted, #a1a1aa);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		padding: 0.2rem 0.6rem;
		border-radius: 9999px;
	}
	.bento-card__icon {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 0.5rem;
		background: var(--surface-3, #27272a);
		color: var(--text-color, #fafafa);
		font-size: 1.25rem;
	}

	.bento-card__media {
		border-radius: var(--radius-md, 0.75rem);
		overflow: hidden;
		max-height: 200px;
		background: #09090b;
		border: 1px solid var(--border-color, #27272a);
	}
	.bento-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.bento-card__code {
		background: #09090b;
		border: 1px solid var(--border-color, #27272a);
		border-radius: var(--radius-md, 0.75rem);
		overflow: hidden;
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.85rem;
	}
	.bento-card__code-bar {
		display: flex;
		gap: 6px;
		padding: 8px 12px;
		background: rgba(255, 255, 255, 0.03);
		border-bottom: 1px solid var(--border-color, #27272a);
	}
	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #3f3f46;
	}
	.bento-card__code pre {
		padding: 12px;
		margin: 0;
		color: #e4e4e7;
		overflow-x: auto;
	}

	.bento-card__content {
		margin-top: auto;
	}
	.bento-card__title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-color, #fafafa);
		margin: 0 0 0.5rem 0;
		line-height: 1.3;
	}
	.bento-card__desc {
		font-size: 0.95rem;
		color: var(--text-muted, #a1a1aa);
		line-height: 1.5;
		margin: 0;
	}

	.bento-card__footer {
		margin-top: 0.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border-color, #27272a);
	}
	.bento-card__link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--text-color, #fafafa);
		text-decoration: none;
		transition: gap 0.2s ease;
	}
	.bento-card__link:hover {
		color: #25d366;
		gap: 0.75rem;
	}
</style>
