---
interface Props {
	title?: string;
	eyebrow?: string;
	price?: string;
	badge?: string;
}

const {
	title = "Jasa Cetak Buku Fisik",
	eyebrow = "EDISI STANDAR PENERBIT",
	price = "Mulai Rp 14.000 / eks",
	badge = "Bisa Cetak Satuan 1 Eks",
} = Astro.props;
---

<div class="mockup-showcase">
	<!-- Stage / Perspective Wrapper -->
	<div class="book-scene">
		<!-- 3D Physical Book Object -->
		<div class="book-object">
			<!-- Spine (Punggung Buku Lem Panas) -->
			<div class="book-spine">
				<span class="spine-text">{title}</span>
			</div>

			<!-- Front Cover (Cover Depan Laminasi Doff) -->
			<div class="book-cover">
				<div class="cover-gloss"></div>
				<div class="cover-crease"></div>
				<div class="cover-content">
					<div class="cover-top">
						<span class="cover-eyebrow">{eyebrow}</span>
						<h3 class="cover-title">{title}</h3>
					</div>
					<div class="cover-bottom">
						<div class="cover-badge">{badge}</div>
						<span class="cover-imprint">KOTACOM PRESS</span>
					</div>
				</div>
			</div>

			<!-- Pages Edge (Ketebalan Kertas Bookpaper Krem) -->
			<div class="book-pages">
				<div class="pages-texture"></div>
			</div>
		</div>

		<!-- Floor Drop Shadow -->
		<div class="book-floor-shadow"></div>

		<!-- 3 High-Converting Floating Selling Pills -->
		<div class="floating-pill pill-top">
			<span class="pill-dot emerald"></span>
			<span>Digital Press 1200 DPI</span>
		</div>

		<div class="floating-pill pill-middle">
			<span class="pill-dot amber"></span>
			<span>Kertas Bookpaper Impor</span>
		</div>

		<div class="floating-pill pill-bottom">
			<span class="pill-dot blue"></span>
			<span>{price}</span>
		</div>
	</div>
</div>

<style>
	.mockup-showcase {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		background: radial-gradient(circle at 50% 40%, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.7) 100%);
		border-radius: var(--radius-xl, 1rem);
		position: relative;
		overflow: hidden;
		min-height: 380px;
	}

	.book-scene {
		perspective: 1200px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		width: 100%;
		max-width: 520px;
		height: 340px;
	}

	.book-object {
		position: relative;
		width: clamp(180px, 28vw, 220px);
		height: clamp(260px, 38vw, 310px);
		transform-style: preserve-3d;
		transform: rotateY(-24deg) rotateX(8deg);
		transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
		cursor: pointer;
	}

	.book-scene:hover .book-object {
		transform: rotateY(-14deg) rotateX(4deg) translateY(-6px);
	}

	/* Spine */
	.book-spine {
		position: absolute;
		left: 0;
		top: 0;
		width: 38px;
		height: 100%;
		background: linear-gradient(90deg, #090d16 0%, #1e1b4b 60%, #172554 100%);
		transform: rotateY(90deg) translateZ(-19px);
		border-radius: 4px 0 0 4px;
		box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.6);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.spine-text {
		color: #fde68a;
		font-family: var(--font-family-mono, monospace);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		transform: rotate(90deg);
		white-space: nowrap;
		max-width: 250px;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Front Cover */
	.book-cover {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, #1e1b4b 0%, #2e1065 60%, #172554 100%);
		border-radius: 2px 8px 8px 2px;
		box-shadow: 
			inset 4px 0 10px rgba(0, 0, 0, 0.5),
			inset -2px 0 5px rgba(255, 255, 255, 0.1),
			10px 15px 35px -5px rgba(0, 0, 0, 0.6);
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.cover-gloss {
		position: absolute;
		inset: 0;
		background: linear-gradient(125deg, rgba(255, 255, 255, 0.18) 0%, transparent 50%, rgba(0, 0, 0, 0.25) 100%);
		pointer-events: none;
	}

	.cover-crease {
		position: absolute;
		left: 12px;
		top: 0;
		bottom: 0;
		width: 2px;
		background: rgba(0, 0, 0, 0.35);
		box-shadow: 1px 0 2px rgba(255, 255, 255, 0.15);
	}

	.cover-content {
		position: relative;
		height: 100%;
		padding: clamp(1.25rem, 2vw, 1.75rem);
		padding-left: clamp(1.5rem, 2.5vw, 2.25rem);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		color: #ffffff;
	}

	.cover-eyebrow {
		display: block;
		font-family: var(--font-family-mono, monospace);
		font-size: 0.6rem;
		font-weight: 700;
		color: #fbbf24;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}

	.cover-title {
		font-size: clamp(0.95rem, 1.8vw, 1.25rem);
		font-weight: 800;
		line-height: 1.2;
		color: #ffffff;
		margin: 0;
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
	}

	.cover-badge {
		display: inline-block;
		background: rgba(16, 185, 129, 0.25);
		border: 1px solid #10b981;
		color: #34d399;
		font-size: 0.65rem;
		font-weight: 700;
		padding: 0.2rem 0.5rem;
		border-radius: 9999px;
		margin-bottom: 0.5rem;
	}

	.cover-imprint {
		display: block;
		font-family: var(--font-family-mono, monospace);
		font-size: 0.6rem;
		color: #94a3b8;
		letter-spacing: 0.08em;
	}

	/* Book Pages (Cream Edge) */
	.book-pages {
		position: absolute;
		right: -18px;
		top: 4px;
		bottom: 4px;
		width: 20px;
		background: #fef3c7;
		border-radius: 0 3px 3px 0;
		box-shadow: inset 2px 0 5px rgba(0, 0, 0, 0.25);
		transform: rotateY(-80deg) translateZ(8px);
	}

	.pages-texture {
		width: 100%;
		height: 100%;
		background: repeating-linear-gradient(
			0deg,
			#fef3c7 0px,
			#fef3c7 2px,
			#fde68a 3px,
			#fef3c7 4px
		);
		opacity: 0.6;
	}

	/* Floor Shadow */
	.book-floor-shadow {
		position: absolute;
		bottom: 12px;
		width: clamp(220px, 35vw, 320px);
		height: 35px;
		background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.65) 0%, rgba(0, 0, 0, 0) 70%);
		border-radius: 50%;
		transform: rotateX(80deg);
		filter: blur(6px);
		pointer-events: none;
	}

	/* Floating Selling Pills */
	.floating-pill {
		position: absolute;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.85rem;
		background: rgba(15, 23, 42, 0.85);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 9999px;
		color: #f8fafc;
		font-size: clamp(0.72rem, 1.2vw, 0.82rem);
		font-weight: 600;
		box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.5);
		z-index: 10;
		transition: transform 0.3s ease;
	}

	.book-scene:hover .floating-pill {
		transform: translateY(-3px);
	}

	.pill-top {
		top: 15%;
		right: clamp(5%, 10vw, 15%);
		border-color: rgba(16, 185, 129, 0.4);
	}

	.pill-middle {
		top: 52%;
		left: clamp(2%, 6vw, 10%);
		border-color: rgba(245, 158, 11, 0.4);
	}

	.pill-bottom {
		bottom: 12%;
		right: clamp(8%, 12vw, 18%);
		border-color: rgba(56, 189, 248, 0.4);
		background: rgba(16, 185, 129, 0.15);
		color: #34d399;
	}

	.pill-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.pill-dot.emerald { background: #10b981; box-shadow: 0 0 8px #10b981; }
	.pill-dot.amber { background: #f59e0b; box-shadow: 0 0 8px #f59e0b; }
	.pill-dot.blue { background: #38bdf8; box-shadow: 0 0 8px #38bdf8; }

	@media (max-width: 640px) {
		.mockup-showcase {
			min-height: 320px;
			padding: 1rem;
		}
		.book-scene {
			height: 280px;
		}
		.pill-middle {
			left: 2%;
			top: 60%;
		}
		.pill-top {
			right: 2%;
			top: 10%;
		}
		.pill-bottom {
			right: 4%;
			bottom: 8%;
		}
	}
</style>
