---
import { Icon } from "astro-iconset/components";

/**
 * BrandOrbit — visual "ekosistem layanan" Kotacom.
 *
 * Logo Kotacom di pusat, dikelilingi 4 lini bisnis (percetakan, cetak buku,
 * software, IT service) dalam orbit konsentris + satelit kecil untuk layanan
 * pendukung. Semua link asli (bukan hiasan), jadi visual ini juga bekerja
 * sebagai navigasi cepat dari hero.
 */
interface OrbitNode {
	label: string;
	hint: string;
	href: string;
	icon: string;
}

interface Props {
	centerLabel?: string;
	nodes?: OrbitNode[];
	class?: string;
}

const DEFAULT_NODES: OrbitNode[] = [
	{ label: "Percetakan", hint: "Offset & digital", href: "/percetakan", icon: "ph:printer" },
	{ label: "Cetak Buku", hint: "ISBN & penerbit", href: "/percetakan/cetak-buku", icon: "ph:book-open" },
	{ label: "Software", hint: "Web, app & POS", href: "/software", icon: "ph:code" },
	{ label: "IT Service", hint: "Hardware & support", href: "/services", icon: "ph:wrench" },
];

const SATELLITES = [
	{ icon: "ph:whatsapp-logo", label: "Konsultasi WhatsApp" },
	{ icon: "ph:magnifying-glass", label: "Audit & riset kata kunci" },
	{ icon: "ph:truck", label: "Pengiriman nasional" },
	{ icon: "ph:pen-nib", label: "Desain & layout" },
];

const {
	centerLabel = "Kotacom",
	nodes = DEFAULT_NODES,
	class: className,
} = Astro.props;

const items = nodes.slice(0, 4);
const positions = ["orbit__node--tl", "orbit__node--tr", "orbit__node--bl", "orbit__node--br"];
---

<div class:list={["orbit", className]} data-brand-orbit>
	<div class="orbit__canvas">
		<svg class="orbit__rings" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
			<g class="orbit__spin">
				<circle cx="300" cy="300" r="278" class="orbit__ring orbit__ring--dashed" />
				<circle cx="300" cy="300" r="214" class="orbit__ring" />
			</g>
			<circle cx="300" cy="300" r="154" class="orbit__ring orbit__ring--dashed" />
			<circle cx="300" cy="300" r="96" class="orbit__ring orbit__ring--core" />
			<g class="orbit__spokes">
				{
					Array.from({ length: 16 }).map((_, i) => {
						const a = (i * Math.PI * 2) / 16;
						const inner = 96;
						const outer = 278;
						return (
							<line
								x1={300 + Math.cos(a) * inner}
								y1={300 + Math.sin(a) * inner}
								x2={300 + Math.cos(a) * outer}
								y2={300 + Math.sin(a) * outer}
							/>
						);
					})
				}
			</g>
			<circle cx="300" cy="300" r="278" class="orbit__ring orbit__ring--edge" />
		</svg>

		<span class="orbit__pulse" aria-hidden="true"></span>

		<div class="orbit__core">
			<img class="orbit__mark" src="/brand/kotacom-mark.png" alt="" width="64" height="64" />
			<img class="orbit__wordmark" src="/brand/kotacom-wordmark.png" alt={centerLabel} width="120" height="36" />
			<span class="orbit__tagline">Satu mitra, empat lini</span>
		</div>

		<ul class="orbit__nodes" aria-label="Lini layanan Kotacom">
			{
				items.map((node, i) => (
					<li class:list={["orbit__node", positions[i]]} style={`--node-delay:${i * 0.65}s`}>
						<a class="orbit__card" href={node.href}>
							<span class="orbit__icon" aria-hidden="true">
								<Icon name={node.icon} />
							</span>
							<span class="orbit__text">
								<strong>{node.label}</strong>
								<small>{node.hint}</small>
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class="orbit__sats" aria-hidden="true">
			{
				SATELLITES.map((sat, i) => (
					<span class:list={["orbit__sat", `orbit__sat--${i + 1}`]} title={sat.label}>
						<Icon name={sat.icon} />
					</span>
				))
			}
		</div>
	</div>
</div>

<style>
	/* Panel menyatu dengan kanvas halaman: tanpa border/kotak, hanya garis
	   horizontal atas-bawah. Warna mengikuti token tema (light/dark). */
	.orbit {
		position: relative;
		container-type: inline-size;
		border-block: 1px solid var(--color-border);
		padding-block: clamp(10px, 2.4vw, 20px);
		color: var(--color-text);
	}

	.orbit__canvas {
		position: relative;
		aspect-ratio: 1 / 1;
		width: 100%;
	}

	.orbit__rings {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.orbit__ring {
		fill: none;
		stroke: var(--color-border-strong);
		stroke-width: 1;
	}

	.orbit__ring--dashed {
		stroke-dasharray: 2 10;
		stroke-linecap: round;
	}

	.orbit__ring--edge {
		stroke: var(--color-border);
	}

	.orbit__spokes line {
		stroke: var(--color-border);
		stroke-width: 1;
	}

	.orbit__spin {
		transform-origin: 300px 300px;
		animation: orbit-spin 120s linear infinite;
	}

	@keyframes orbit-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.orbit__pulse {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 32%;
		aspect-ratio: 1;
		translate: -50% -50%;
		border-radius: 50%;
		border: 1px solid var(--color-brand-accent-glow);
		animation: orbit-pulse 5.5s cubic-bezier(0.2, 0.6, 0.3, 1) infinite;
		pointer-events: none;
	}

	@keyframes orbit-pulse {
		0% {
			transform: scale(0.72);
			opacity: 0.6;
		}
		70%,
		100% {
			transform: scale(1.35);
			opacity: 0;
		}
	}

	/* ---------- pusat: logo resmi ---------- */
	.orbit__core {
		position: absolute;
		left: 50%;
		top: 50%;
		translate: -50% -50%;
		display: grid;
		justify-items: center;
		gap: 8px;
		text-align: center;
		z-index: 2;
	}

	.orbit__mark {
		display: block;
		width: clamp(48px, 13cqw, 66px);
		height: auto;
	}

	.orbit__wordmark {
		display: block;
		width: clamp(80px, 22cqw, 120px);
		height: auto;
	}

	.orbit__tagline {
		font-size: clamp(9px, 2.1cqw, 11px);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	@media (prefers-color-scheme: dark) {
		.orbit__mark,
		.orbit__wordmark {
			filter: invert(1);
		}
	}

	/* ---------- node lini bisnis: tanpa border, tanpa latar ikon ---------- */
	.orbit__nodes {
		position: absolute;
		inset: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		z-index: 3;
	}

	.orbit__node {
		position: absolute;
		translate: -50% -50%;
		animation: orbit-bob 7s ease-in-out infinite;
		animation-delay: var(--node-delay, 0s);
	}

	.orbit__node--tl {
		left: 20%;
		top: 19%;
	}

	.orbit__node--tr {
		left: 80%;
		top: 19%;
	}

	.orbit__node--bl {
		left: 20%;
		top: 81%;
	}

	.orbit__node--br {
		left: 80%;
		top: 81%;
	}

	@keyframes orbit-bob {
		0%,
		100% {
			translate: -50% -50%;
		}
		50% {
			translate: -50% calc(-50% - 4px);
		}
	}

	.orbit__card {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		/* latar = kanvas, hanya agar garis orbit tidak menembus teks */
		background: var(--color-bg);
		color: inherit;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.orbit__card:hover strong,
	.orbit__card:focus-visible strong {
		color: var(--color-brand-accent);
	}

	.orbit__card:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 2px;
	}

	.orbit__icon {
		display: grid;
		place-items: center;
		color: var(--color-text);
		font-size: clamp(16px, 3.8cqw, 20px);
		flex: none;
	}

	.orbit__text {
		display: grid;
		gap: 1px;
		text-align: left;
		line-height: 1.15;
	}

	.orbit__text strong {
		font-size: clamp(11px, 2.6cqw, 13px);
		font-weight: 700;
		color: var(--color-text);
		transition: color 0.2s ease;
	}

	.orbit__text small {
		font-size: clamp(9px, 2cqw, 11px);
		color: var(--color-muted);
	}

	/* ---------- satelit: ikon polos ---------- */
	.orbit__sats {
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.orbit__sat {
		position: absolute;
		display: grid;
		place-items: center;
		padding: 4px;
		translate: -50% -50%;
		background: var(--color-bg);
		color: var(--color-muted);
		font-size: clamp(12px, 2.8cqw, 15px);
	}

	.orbit__sat--1 {
		left: 50%;
		top: 4.5%;
	}

	.orbit__sat--2 {
		left: 95.5%;
		top: 50%;
	}

	.orbit__sat--3 {
		left: 50%;
		top: 95.5%;
	}

	.orbit__sat--4 {
		left: 4.5%;
		top: 50%;
	}

	@media (max-width: 480px) {
		.orbit__card {
			padding: 4px 6px;
			gap: 6px;
		}

		.orbit__text small {
			display: none;
		}

		.orbit__node--tl,
		.orbit__node--bl {
			left: 21%;
		}

		.orbit__node--tr,
		.orbit__node--br {
			left: 79%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.orbit__spin,
		.orbit__pulse,
		.orbit__node {
			animation: none;
		}
	}
</style>
