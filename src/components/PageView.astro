---
import type { ContentEntry } from "emdash";
import { PortableText } from "emdash/ui";
import type { Page } from "../../emdash-env";
import MarketingBlocks from "./MarketingBlocks.astro";
import "../styles/prose.css";

interface Props {
	page: ContentEntry<Page>;
	/** The heading shown when the page has no hero. Defaults to the page title. */
	heading?: string;
}

const { page, heading } = Astro.props;
const title = heading ?? page.data.title;
const titleEdit = heading === undefined ? (page as any).edit?.title : {};

// Support both:
// 1. Separate "blocks" field and "content" field
// 2. Legacy fallback where marketing blocks were saved directly in "content"
const rawBlocks = (page.data as any).blocks;
const rawContent = page.data.content;

const isMarketingBlockArray = (val: any) =>
	Array.isArray(val) &&
	val.length > 0 &&
	val.some(
		(item: any) =>
			item &&
			typeof item === "object" &&
			"_type" in item &&
			(String(item._type).startsWith("marketing_") || String(item._type).startsWith("marketing.")),
	);

let blocks: any[] = [];
let richContent: any = null;

if (Array.isArray(rawBlocks) && rawBlocks.length > 0) {
	blocks = rawBlocks;
}

if (rawContent) {
	if (isMarketingBlockArray(rawContent) && blocks.length === 0) {
		blocks = rawContent;
	} else if (!isMarketingBlockArray(rawContent)) {
		richContent = rawContent;
	}
}

const hasBlocks = blocks.length > 0;
const hasRichContent = !!richContent && (Array.isArray(richContent) ? richContent.length > 0 : true);
const hasHero = hasBlocks && blocks.some((b: any) => b._type === "marketing_hero" || b._type === "marketing.hero" || b._type === "hero" || b._type === "hero-2");
const blocksEdit = (page as any).edit?.blocks ?? (page as any).edit?.content ?? {};
const contentEdit = (page as any).edit?.content ?? {};
---

{
	hasBlocks || hasRichContent ? (
		<>
			{!hasHero && (
				<header class="intro page-header">
					<div class="frame">
						<h1 class="intro__title page-header__title" {...titleEdit}>
							{title}
						</h1>
					</div>
				</header>
			)}

			{hasBlocks && (
				<div class="page-blocks" {...blocksEdit}>
					<MarketingBlocks value={blocks} />
				</div>
			)}

			{hasRichContent && (
				<section class="band page-rich-content">
					<div class="frame">
						<div class="prose mx-auto" {...contentEdit}>
							<PortableText value={richContent} />
						</div>
					</div>
				</section>
			)}
		</>
	) : (
		<section class="band section empty-state-section">
			<div class="frame empty-state">
				<h1 class="intro__title empty-state__title">{title}</h1>
				{Astro.locals.user && (
					<>
						<p class="lead">This page has no content yet. Add content or blocks in the editor, then publish.</p>
						<div class="actions">
							<a href={`/_emdash/admin/content/pages/${page.data.id}`} class="btn btn-lg">
								Edit page
							</a>
						</div>
					</>
				)}
			</div>
		</section>
	)
}

<style>
	.page-header__title {
		max-width: 20ch;
	}
	.page-blocks :global(> :not(section):not(.band)) {
		max-width: var(--content-width, 740px);
		margin-inline: auto;
		padding-inline: var(--spacing-4, 1.5rem);
	}
	.page-rich-content {
		padding-block: clamp(2rem, 1.5rem + 2vw, 4rem);
	}
	.page-rich-content .prose {
		max-width: var(--content-width, 740px);
	}
</style>
