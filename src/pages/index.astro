---
import { getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/PageView.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { heroSeoDefaults } from "../utils/page";
import { getSiteOrigin } from "../utils/origin";

const { entry: homePage, cacheHint } = await getEmDashEntry("pages", "home");
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

const settings = await getSiteSettings();
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

const blocks = (homePage?.data as any)?.blocks ?? (Array.isArray(homePage?.data?.content) && (homePage?.data?.content as any[]).some((b: any) => b && typeof b === "object" && "_type" in b && (String(b._type).startsWith("marketing_") || String(b._type).startsWith("marketing."))) ? homePage?.data?.content : []);
const content = homePage?.data?.content;
const hasHomePage = !!homePage && ((Array.isArray(blocks) && blocks.length > 0) || (Array.isArray(content) && content.length > 0));

const siteOrigin = getSiteOrigin(Astro.site, Astro.url.origin);
const heroDefaults = hasHomePage ? heroSeoDefaults(blocks as any, siteOrigin) : {};
const defaultHomeOg = `${siteOrigin}/images/kotacom-split-production-ready/hero/hero-cetak-buku-shark-v2.png`;

const defaultTitle = "Kotacom | Solusi IT, Website, Software & Percetakan Surabaya";
const defaultDescription = "Jasa IT terpadu pembuatan website, software custom, IT support, dan cetak profesional di Surabaya. Dapatkan pendekatan terstruktur dari tim Kotacom sesuai kebutuhan bisnis Anda.";

const seo = homePage
	? getSeoMeta(homePage, {
			siteTitle: siteTitle.toLowerCase(),
			siteUrl: siteOrigin,
			path: "/",
			defaultTitle,
			defaultDescription,
			defaultOgImage: defaultHomeOg,
			titleSeparator: " | ",
	  })
	: {
			title: `${defaultTitle} | ${siteTitle.toLowerCase()}`,
			description: defaultDescription,
			ogImage: defaultHomeOg,
			canonical: siteOrigin,
	  };

const pageTitle = seo.title || `${defaultTitle} | ${siteTitle.toLowerCase()}`;
const pageDesc = seo.description || defaultDescription;
const pageImage = seo.ogImage || defaultHomeOg;
const pageCanonical = seo.canonical || siteOrigin;
---

<Base
	title={pageTitle}
	description={pageDesc}
	image={pageImage}
	canonical={pageCanonical}
	type="website"
	content={hasHomePage ? { collection: "pages", id: homePage.data.id, slug: "home" } : undefined}
>
	{hasHomePage && <PageView page={homePage as any} heading={siteTitle} />}
</Base>
