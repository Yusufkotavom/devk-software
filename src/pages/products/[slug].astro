---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { formatDate } from "../../utils/locale";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { buildOgImageUrl } from "../../lib/og/url";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: product, cacheHint } = await getEmDashEntry("products", slug);

if (!product) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Resolve the featured image URL for the hero + OG fallback. The image may
// have a direct `src` (external) or a `meta.storageKey` (local uploads).
function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(product.data.featured_image);
// Plan B fallback: the auto-generated OG card doubles as the feature image.
const productOgFallback = buildOgImageUrl(Astro.url.origin, "products", slug);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(product, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl ?? productOgFallback,
});

// A few other products, newest first (excluding the current one).
const { entries: recentProducts, cacheHint: recentProductsCacheHint } =
	await getEmDashCollection("products", {
		orderBy: { created_at: "desc" },
		limit: 4,
	});
if (Astro.cache?.enabled) Astro.cache.set(recentProductsCacheHint);
const otherProducts = recentProducts.filter((p) => p.id !== product.id).slice(0, 3);

const createdAt = product.data.createdAt ?? null;
const createdDate = createdAt ? formatDate(createdAt, "long") : null;
import { getWhatsAppSettings, buildWhatsAppHref } from "../../utils/whatsapp";

const setting = await getWhatsAppSettings();
const productUrl = Astro.url.href;
const productWaUrl = buildWhatsAppHref(setting, {
	pageUrl: productUrl,
	pageTitle: product.data.title,
	context: "product",
});
const buyLabel = setting?.product_cta_label || "Beli Sekarang / Tanya via WhatsApp";
---

<Base
	title={seo.title}
	pageTitle={product.data.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	modifiedTime={product.data.updatedAt.toISOString()}
	content={{ collection: "products", id: product.data.id, slug }}
>
	<article class="post">
		<header class="intro post-header">
			<div class="frame">
				<div class="post-header__inner">
					<a href="/products" class="arrow-link back-link">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M19 12H5"></path>
							<path d="m12 19-7-7 7-7"></path>
						</svg>
						All products
					</a>
					<p class="eyebrow">Produk</p>
					<h1 class="intro__title post-header__title" {...product.edit.title}>
						{product.data.title}
					</h1>
					{
						product.data.excerpt && (
							<p class="intro__lead post-header__lead" {...product.edit.excerpt}>
								{product.data.excerpt}
							</p>
						)
					}
					{
						createdDate && (
							<p class="post-header__dateline">
								<time datetime={createdAt.toISOString()}>{createdDate}</time>
							</p>
						)
					}
					<div class="product-header-cta">
						<a
							href={productWaUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="product-buy-btn"
						>
							<svg
								class="product-buy-btn__icon"
								viewBox="0 0 24 24"
								fill="currentColor"
								width="22"
								height="22"
							>
								<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.69C7.02 10.9 7.9 12.07 8.02 12.23C8.14 12.39 9.73 14.85 12.18 15.91C12.76 16.16 13.22 16.31 13.57 16.42C14.16 16.61 14.7 16.58 15.12 16.52C15.6 16.45 16.58 15.92 16.79 15.34C16.99 14.76 16.99 14.26 16.93 14.15C16.87 14.05 16.71 13.99 16.47 13.87C16.22 13.75 15.01 13.15 14.78 13.07C14.56 12.99 14.4 12.95 14.23 13.19C14.07 13.44 13.6 14.01 13.46 14.17C13.32 14.33 13.18 14.35 12.94 14.23C12.69 14.11 11.9 13.85 10.96 13.01C10.23 12.36 9.73 11.55 9.59 11.31C9.45 11.07 9.57 10.94 9.7 10.82C9.81 10.71 9.95 10.53 10.07 10.39C10.19 10.25 10.23 10.15 10.31 9.99C10.39 9.83 10.35 9.68 10.29 9.56C10.23 9.44 9.76 8.24 9.55 7.74C9.36 7.26 9.16 7.32 9.01 7.31C8.87 7.31 8.7 7.33 8.53 7.33Z"/>
							</svg>
							<span>{buyLabel}</span>
						</a>
					</div>
				</div>
			</div>
		</header>

		<div class="band post-hero">
			<div class="frame">
				<div class="post-hero__media" {...product.edit.featured_image}>
					{
						product.data.featured_image ? (
							<Image
								image={product.data.featured_image}
								sizes="(min-width: 1264px) 1136px, 92vw"
								priority
							/>
						) : (
							<img
								src={productOgFallback}
								alt=""
								width="1200"
								height="630"
								class="post-hero__og-image"
								loading="eager"
								decoding="sync"
							/>
						)
					}
				</div>
			</div>
		</div>

		<div class="band section">
			<div class="frame post-layout">
				<div class="post-main">
					<div class="prose">
						<PortableText value={product.data.content} />
					</div>

					<div class="product-bottom-cta">
						<div class="product-bottom-cta__card">
							<div class="product-bottom-cta__info">
								<h3 class="product-bottom-cta__title">Tertarik dengan {product.data.title}?</h3>
								<p class="product-bottom-cta__desc">Hubungi kami sekarang untuk ketersediaan stok, negosiasi penawaran, atau opsi pengiriman.</p>
							</div>
							<a
								href={productWaUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="product-buy-btn product-buy-btn--bottom"
							>
								<svg
									class="product-buy-btn__icon"
									viewBox="0 0 24 24"
									fill="currentColor"
									width="20"
									height="20"
								>
									<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.69C7.02 10.9 7.9 12.07 8.02 12.23C8.14 12.39 9.73 14.85 12.18 15.91C12.76 16.16 13.22 16.31 13.57 16.42C14.16 16.61 14.7 16.58 15.12 16.52C15.6 16.45 16.58 15.92 16.79 15.34C16.99 14.76 16.99 14.26 16.93 14.15C16.87 14.05 16.71 13.99 16.47 13.87C16.22 13.75 15.01 13.15 14.78 13.07C14.56 12.99 14.4 12.95 14.23 13.19C14.07 13.44 13.6 14.01 13.46 14.17C13.32 14.33 13.18 14.35 12.94 14.23C12.69 14.11 11.9 13.85 10.96 13.01C10.23 12.36 9.73 11.55 9.59 11.31C9.45 11.07 9.57 10.94 9.7 10.82C9.81 10.71 9.95 10.53 10.07 10.39C10.19 10.25 10.23 10.15 10.31 9.99C10.39 9.83 10.35 9.68 10.29 9.56C10.23 9.44 9.76 8.24 9.55 7.74C9.36 7.26 9.16 7.32 9.01 7.31C8.87 7.31 8.7 7.33 8.53 7.33Z"/>
								</svg>
								<span>{buyLabel}</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</article>

	{
		otherProducts.length > 0 && (
			<section class="band section" aria-labelledby="more-products">
				<div class="frame related">
					<div class="section-head">
						<h2 id="more-products" class="section-head__title">
							Produk lainnya
						</h2>
						<a href="/products" class="arrow-link">
							Semua produk
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="post-grid">
						{otherProducts.map((p) => (
							<PostCard post={p as any} collection="products" variant="card" headingLevel={3} />
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>

<style>
	.product-header-cta {
		margin-top: 1.5rem;
	}
	.product-buy-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.875rem 1.75rem;
		border-radius: var(--radius-md, 0.75rem);
		background: #25d366;
		color: #ffffff !important;
		font-size: 1rem;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
		transition: all 0.2s ease;
	}
	.product-buy-btn:hover {
		background: #20ba59;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(37, 211, 102, 0.45);
	}
	.product-bottom-cta {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-color, #27272a);
	}
	.product-bottom-cta__card {
		background: var(--surface-2, #18181b);
		border: 1px solid var(--border-color, #27272a);
		border-radius: var(--radius-lg, 1rem);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: flex-start;
	}
	@media (min-width: 640px) {
		.product-bottom-cta__card {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
	.product-bottom-cta__title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-color, #fafafa);
		margin: 0 0 0.5rem 0;
	}
	.product-bottom-cta__desc {
		font-size: 0.95rem;
		color: var(--text-muted, #a1a1aa);
		margin: 0;
	}
	.post-header {
		padding-block: clamp(2rem, 1.25rem + 3vw, 4rem)
			clamp(2.5rem, 1.75rem + 2.5vw, 3.5rem);
	}

	.post-header__inner {
		max-width: var(--content-width);
		margin-inline: auto;
	}

	.back-link {
		margin-block-end: clamp(2rem, 1.5rem + 2vw, 3rem);
	}

	.back-link:hover svg {
		translate: -2px 0;
	}

	.post-header__lead {
		font-size: var(--font-size-xl);
		line-height: var(--leading-normal);
	}

	.post-header__dateline {
		margin-block-start: var(--spacing-4);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		font-variant-numeric: tabular-nums;
	}

	.post-hero {
		padding-block: clamp(1rem, 0.5rem + 2vw, 2rem);
	}

	.post-hero__media {
		position: relative;
		overflow: hidden;
		aspect-ratio: 2 / 1;
		border-radius: var(--radius-xl);
		background: var(--color-fill);
	}

	.post-hero__media::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		outline: 1px solid var(--color-media-outline);
		outline-offset: -1px;
		pointer-events: none;
	}

	.post-hero__media :global(img) {
		width: 100%;
		max-width: none;
		height: 100%;
		object-fit: cover;
	}

	.post-hero__og-image {
		display: block;
		width: 100%;
		max-width: none;
		height: 100%;
		object-fit: cover;
	}

	.post-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}

	.post-main {
		width: 100%;
		max-width: var(--content-width);
		margin-inline: auto;
	}

	.related .post-grid {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
	}

	@media (max-width: 720px) {
		.post-header__lead {
			font-size: var(--font-size-lg);
		}

		.post-hero__media {
			aspect-ratio: 16 / 9;
			border-radius: var(--radius-lg);
		}
	}
</style>
