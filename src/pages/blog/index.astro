---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getSiteOrigin } from "../../utils/origin";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));

const siteOrigin = getSiteOrigin(Astro.site, Astro.url.origin);
const canonicalUrl = `${siteOrigin}/blog`;
---

<Base
	title="Blog & Wawasan | Kotacom"
	description="Artikel, panduan, dan wawasan seputar teknologi, percetakan buku, pembuatan website, dan pengembangan software dari Kotacom."
	canonical={canonicalUrl}
>
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Blog & Wawasan</p>
			<h1 class="intro__title">Artikel & Panduan</h1>
			<p class="intro__lead">Wawasan mendalam seputar IT, percetakan, dan solusi bisnis digital.</p>
		</div>
	</header>

	<section class="band section archive-band">
		<div class="frame">
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? "Tidak ada artikel lagi" : "Belum ada artikel"}
						</h2>
						<p class="empty-state__text">
							{cursor
								? "Anda telah mencapai akhir arsip artikel."
								: "Artikel yang dipublikasikan akan muncul di sini."}
						</p>
						{cursor && (
							<div class="empty-state__actions">
								<a href="/blog" class="btn btn--ghost">
									Halaman pertama
								</a>
							</div>
						)}
					</div>
				) : (
					<>
						<ol class="archive__list">
							{postsWithTags.map(({ post, tags }) => (
								<li>
									<PostCard post={post} tags={tags} variant="row" collection="posts" />
								</li>
							))}
						</ol>
						<Pagination
							basePath="/blog"
							cursor={cursor}
							nextCursor={nextCursor}
						/>
					</>
				)
			}
		</div>
	</section>
</Base>

<style>
	.archive-band {
		padding-block-start: 0;
	}

	.archive__list {
		list-style: none;
	}

	.archive__list > li + li {
		border-block-start: 1px solid var(--color-border);
	}
</style>
