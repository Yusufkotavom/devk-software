---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/PageView.astro";
import RelatedLinks from "../components/RelatedLinks.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { heroSeoDefaults } from "../utils/page";
import { buildOgImageUrl } from "../lib/og/url";
import { getSiteOrigin } from "../utils/origin";
import "../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const blocks = (page.data as any).blocks ?? (Array.isArray(page.data.content) && page.data.content.some((b: any) => b && typeof b === "object" && "_type" in b && (String(b._type).startsWith("marketing_") || String(b._type).startsWith("marketing."))) ? page.data.content : []);
const siteOrigin = getSiteOrigin(Astro.site, Astro.url.origin);
const heroDefaults = heroSeoDefaults(blocks as any, siteOrigin);

const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: siteOrigin,
	path: `/${page.id}`,
	...heroDefaults,
	defaultOgImage: heroDefaults.defaultOgImage ?? buildOgImageUrl(siteOrigin, "pages", slug),
});
---

<Base
	title={page.data.title}
	pageTitle={page.data.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug: page.id }}
>
	<PageView page={page as any} />
	<RelatedLinks slug={String(page.id)} pageTitle={page.data.title} pageUrl={`${siteOrigin}/${page.id}`} />
</Base>
