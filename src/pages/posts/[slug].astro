---
import {
	getEmDashEntry,
	getEmDashCollection,
	getTermsForEntries,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import { blockComponents } from "../../plugins/marketing-blocks/astro";
import { Comments, CommentForm } from "emdash/ui/comments";
import Base from "../../layouts/Base.astro";
import Byline from "../../components/Byline.astro";
import PostCard from "../../components/PostCard.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { buildOgImageUrl } from "../../lib/og/url";
import { getSiteOrigin } from "../../utils/origin";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const siteOrigin = getSiteOrigin(Astro.site, Astro.url.origin);

// Get featured image URL for OG fallback
// The image may have src (external) or meta.storageKey (local)
function getImageUrl(img: unknown): string | undefined {
	if (!img) return undefined;
	if (typeof img === "string") {
		if (img.startsWith("http")) return img;
		if (img.startsWith("/")) return `${siteOrigin}${img}`;
		return undefined;
	}
	if (typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	// Check for direct src
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http")
			? image.src
			: `${siteOrigin}${image.src.startsWith("/") ? "" : "/"}${image.src}`;
	}
	// Build from storageKey for local images
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) {
		return `${siteOrigin}/_emdash/api/media/file/${storageKey}`;
	}
	return undefined;
}
const featuredImageUrl = getImageUrl(post.data.featured_image);
// Plan B fallback: the auto-generated OG card doubles as the feature image
// (hero + lists) when a post has no featured image of its own.
const postOgFallback = buildOgImageUrl(siteOrigin, "posts", slug);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// Generate SEO meta from content. When a post has no featured image, fall back
// to the auto-generated branded OG card so no post is ever left without a
// social preview image.
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: siteOrigin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl ?? postOgFallback,
});

// Bylines are already hydrated by getEmDashEntry
const bylines = post.data.bylines ?? [];

// Get reading time
const readingTime = getReadingTime(post.data.content);

// This post's tags are already hydrated onto the entry by getEmDashEntry —
// no extra query needed.
const tags = post.data.terms?.tag ?? [];

// Fetch recent posts with semantic topic prioritization.
const { entries: allRecentPosts, cacheHint: recentPostsCacheHint } =
	await getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 10,
	});
if (Astro.cache?.enabled) Astro.cache.set(recentPostsCacheHint);

// Prioritize related posts by matching slug topic clusters
const currentSlug = String(slug);
const isSoftwarePost = currentSlug.includes("pos") || currentSlug.includes("crm") || currentSlug.includes("astro");
const isRemotePost = currentSlug.includes("autocad") || currentSlug.includes("adobe") || currentSlug.includes("install-online");
const isHardwarePost = currentSlug.includes("lemot") || currentSlug.includes("ssd") || currentSlug.includes("komputer");

const candidatePosts = allRecentPosts.filter((p) => p.id !== post.id);
const relatedRanked = candidatePosts.sort((a, b) => {
	const aSlug = String(a.id);
	const bSlug = String(b.id);
	if (isSoftwarePost) {
		const aMatch = aSlug.includes("pos") || aSlug.includes("crm") || aSlug.includes("astro");
		const bMatch = bSlug.includes("pos") || bSlug.includes("crm") || bSlug.includes("astro");
		if (aMatch && !bMatch) return -1;
		if (!aMatch && bMatch) return 1;
	} else if (isRemotePost) {
		const aMatch = aSlug.includes("autocad") || aSlug.includes("adobe") || aSlug.includes("install");
		const bMatch = bSlug.includes("autocad") || bSlug.includes("adobe") || bSlug.includes("install");
		if (aMatch && !bMatch) return -1;
		if (!aMatch && bMatch) return 1;
	} else if (isHardwarePost) {
		const aMatch = aSlug.includes("lemot") || aSlug.includes("ssd") || aSlug.includes("komputer");
		const bMatch = bSlug.includes("lemot") || bSlug.includes("ssd") || bSlug.includes("komputer");
		if (aMatch && !bMatch) return -1;
		if (!aMatch && bMatch) return 1;
	}
	return 0;
});
const otherPosts = relatedRanked.slice(0, 3);

// Single batched query for related-posts tags, rather than one
// getEntryTerms() call per related post.
const otherTagsByEntry = await getTermsForEntries(
	"posts",
	otherPosts.map((p) => p.data.id),
	"tag",
);
const otherPostsWithTags = otherPosts.map((p) => ({
	post: p,
	tags: (otherTagsByEntry.get(p.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));

const publishedAt = post.data.publishedAt ?? null;
const publishDate = publishedAt ? formatDate(publishedAt, "long") : null;

// The script below builds the table of contents and has the final say; this
// guess keeps the sidebar from shifting when the page loads.
const hasHeadings = (post.data.content ?? []).some(
	(block) =>
		(block._type === "block" &&
			"style" in block &&
			(block.style === "h2" || block.style === "h3")) ||
		(block._type === "legacy-rich-content" &&
			typeof block.contentRaw === "string" &&
			(block.contentRaw.includes("<h2") ||
				block.contentRaw.includes("<h3") ||
				block.contentRaw.includes("## ") ||
				block.contentRaw.includes("### "))),
);
import { getWhatsAppSettings, buildWhatsAppHref } from "../../utils/whatsapp";

const setting = await getWhatsAppSettings();
const postUrl = `${siteOrigin}${Astro.url.pathname}`;
const postWaUrl = buildWhatsAppHref(setting, {
	pageUrl: postUrl,
	pageTitle: post.data.title,
	context: "post",
});
const postCtaLabel = setting?.post_cta_label || "Konsultasi Jasa Software via WhatsApp";
---

<Base
	title={post.data.title}
	pageTitle={post.data.title}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="post">
		<header class="intro post-header">
			<div class="frame">
				<div class="post-header__inner">
					<Breadcrumb
						items={[
							{ label: "Blog", href: "/posts" },
							{ label: post.data.title },
						]}
					/>
					{
						tags.length > 0 && (
							<ul class="chips post-header__tags" aria-label="Tags">
								{tags.map((t) => (
									<li>
										<a href={`/tag/${t.slug}`} class="chip">
											{t.label}
										</a>
									</li>
								))}
							</ul>
						)
					}
					<h1 class="intro__title post-header__title" {...post.edit.title}>
						{post.data.title}
					</h1>
					{
						post.data.excerpt && (
							<p class="intro__lead post-header__lead" {...post.edit.excerpt}>
								{post.data.excerpt}
							</p>
						)
					}
					<div class="post-header__meta">
						<Byline bylines={bylines} layout="inline" max={2} size="md" />
						<p class="post-header__dateline">
							{
								publishedAt && (
									<time datetime={publishedAt.toISOString()}>
										{publishDate}
									</time>
								)
							}
							<span>{readingTime} min read</span>
						</p>
					</div>
				</div>
			</div>
		</header>

		{
			post.data.featured_image ? (
				<div class="band post-hero">
					<div class="frame">
						<div class="post-hero__media" {...post.edit.featured_image}>
							{typeof post.data.featured_image === "string" ? (
								<img src={post.data.featured_image} alt={post.data.title} class="post-hero__image" />
							) : (
								<Image
									image={post.data.featured_image}
									sizes="(min-width: 1200px) 1120px, 92vw"
									priority
								/>
							)}
						</div>
					</div>
				</div>
			) : (
				<div class="band post-hero">
					<div class="frame">
						<div class="post-hero__media">
							<img
								src={`/og/posts/${encodeURIComponent(slug)}.png`}
								alt=""
								width="1200"
								height="630"
								class="post-hero__og-image"
								loading="eager"
								decoding="sync"
							/>
						</div>
					</div>
				</div>
			)
		}

		<div class="band section">
			<div class="frame post-layout">
				<div class="post-meta">
					<dl class="post-facts">
						{
							bylines.length > 0 && (
								<div class="post-fact">
									<dt class="eyebrow">
										{bylines.length === 1 ? "Author" : "Authors"}
									</dt>
									<dd>
										<Byline bylines={bylines} layout="list" />
									</dd>
								</div>
							)
						}
						{
							publishedAt && (
								<div class="post-fact">
									<dt class="eyebrow">Published</dt>
									<dd>
										<time datetime={publishedAt.toISOString()}>
											{publishDate}
										</time>
									</dd>
								</div>
							)
						}
						<div class="post-fact">
							<dt class="eyebrow">Reading time</dt>
							<dd>{readingTime} min</dd>
						</div>
					</dl>
				</div>

				<div class="post-main">
					<div class="post-wa-inline post-wa-inline--top">
						<a
							href={postWaUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="post-wa-banner"
						>
							<span class="post-wa-icon-wrap" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
									<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.69C7.02 10.9 7.9 12.07 8.02 12.23C8.14 12.39 9.73 14.85 12.18 15.91C12.76 16.16 13.22 16.31 13.57 16.42C14.16 16.61 14.7 16.58 15.12 16.52C15.6 16.45 16.58 15.92 16.79 15.34C16.99 14.76 16.99 14.26 16.93 14.15C16.87 14.05 16.71 13.99 16.47 13.87C16.22 13.75 15.01 13.15 14.78 13.07C14.56 12.99 14.4 12.95 14.23 13.19C14.07 13.44 13.6 14.01 13.46 14.17C13.32 14.33 13.18 14.35 12.94 14.23C12.69 14.11 11.9 13.85 10.96 13.01C10.23 12.36 9.73 11.55 9.59 11.31C9.45 11.07 9.57 10.94 9.7 10.82C9.81 10.71 9.95 10.53 10.07 10.39C10.19 10.25 10.23 10.15 10.31 9.99C10.39 9.83 10.35 9.68 10.29 9.56C10.23 9.44 9.76 8.24 9.55 7.74C9.36 7.26 9.16 7.32 9.01 7.31C8.87 7.31 8.7 7.33 8.53 7.33Z"/>
								</svg>
							</span>
							<span class="post-wa-badge">Konsultasi</span>
							<span class="post-wa-text">Butuh software & sistem untuk bisnis? <strong>Chat Teknisi Langsung &rarr;</strong></span>
						</a>
					</div>

					<nav
						class="toc toc--inline"
						aria-labelledby="toc-inline-title"
						hidden={!hasHeadings}
						data-toc-inline
					>
						<details class="toc__details" open>
							<summary class="toc__summary">
								<span id="toc-inline-title" class="eyebrow">Daftar Isi (Table of Contents)</span>
								<svg class="toc__chevron" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
									<path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
								</svg>
							</summary>
							<ol class="toc__list" data-toc-inline-list></ol>
						</details>
					</nav>

					<div class="prose" data-post-content>
						<PortableText value={post.data.content} components={{ type: blockComponents }} />
					</div>

					<div class="post-wa-box">
						<div class="post-wa-box__content">
							<span class="post-wa-box__badge">LAYANAN PERCETAKAN &amp; IT • KOTACOM</span>
							<h3 class="post-wa-box__title">Konsultasi Cetak Buku &amp; Solusi IT Kotacom</h3>
							<p class="post-wa-box__desc">Cetak buku novel, Al-Qur'an, majalah, profil perusahaan, hingga sistem software &amp; website terintegrasi. Konsultasikan kebutuhan proyek Anda dengan tim ahli Kotacom.</p>
							<div class="post-service-links" style="margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px;">
								<a href="/products" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; text-decoration: none; color: var(--color-text);">
									<span>Katalog Produk Cetak →</span>
								</a>
								<a href="/posts" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 13px; font-weight: 500; text-decoration: none; color: var(--color-text-secondary);">
									<span>Artikel &amp; Panduan</span>
								</a>
								<a href="/about" style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 13px; font-weight: 500; text-decoration: none; color: var(--color-text-secondary);">
									<span>Tentang Kotacom</span>
								</a>
							</div>
						</div>
						<a
							href={postWaUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="post-wa-box__btn"
						>
							<svg
								viewBox="0 0 24 24"
								fill="currentColor"
								width="20"
								height="20"
							>
								<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2ZM12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19.01L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67ZM8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.69C7.02 10.9 7.9 12.07 8.02 12.23C8.14 12.39 9.73 14.85 12.18 15.91C12.76 16.16 13.22 16.31 13.57 16.42C14.16 16.61 14.7 16.58 15.12 16.52C15.6 16.45 16.58 15.92 16.79 15.34C16.99 14.76 16.99 14.26 16.93 14.15C16.87 14.05 16.71 13.99 16.47 13.87C16.22 13.75 15.01 13.15 14.78 13.07C14.56 12.99 14.4 12.95 14.23 13.19C14.07 13.44 13.6 14.01 13.46 14.17C13.32 14.33 13.18 14.35 12.94 14.23C12.69 14.11 11.9 13.85 10.96 13.01C10.23 12.36 9.73 11.55 9.59 11.31C9.45 11.07 9.57 10.94 9.7 10.82C9.81 10.71 9.95 10.53 10.07 10.39C10.19 10.25 10.23 10.15 10.31 9.99C10.39 9.83 10.35 9.68 10.29 9.56C10.23 9.44 9.76 8.24 9.55 7.74C9.36 7.26 9.16 7.32 9.01 7.31C8.87 7.31 8.7 7.33 8.53 7.33Z"/>
							</svg>
							<span>{postCtaLabel || "Hubungi Tim Jasa Kami"}</span>
						</a>
					</div>

					<section class="post-comments" aria-labelledby="comments-title">
						<h2 id="comments-title" class="eyebrow">Discussion</h2>
						<Comments collection="posts" contentId={post.data.id} threaded />
						<CommentForm collection="posts" contentId={post.data.id} />
					</section>
				</div>

				<div class="post-rail">
					<nav
						class="toc"
						aria-labelledby="toc-title"
						hidden={!hasHeadings}
						data-toc
					>
						<h2 id="toc-title" class="eyebrow">On this page</h2>
						<ol class="toc__list" data-toc-list></ol>
					</nav>

					<aside class="post-widgets" aria-labelledby="widgets-title">
						<h2 id="widgets-title" class="sr-only">More from the blog</h2>
						<WidgetArea name="sidebar" />
					</aside>
				</div>
			</div>
		</div>
	</article>

	{
		otherPostsWithTags.length > 0 && (
			<section class="band section" aria-labelledby="continue-reading">
				<div class="frame related">
					<div class="section-head">
						<h2 id="continue-reading" class="section-head__title">
							Continue reading
						</h2>
						<a href="/posts" class="arrow-link">
							All posts
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path d="M5 12h14" />
								<path d="m12 5 7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="post-grid">
						{otherPostsWithTags.map(({ post: p, tags: postTags }) => (
							<PostCard
								post={p}
								tags={postTags}
								variant="card"
								headingLevel={3}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}

	<script>
		// Build the table of contents from the body's h2/h3 headings
		function buildToc() {
			const content = document.querySelector("[data-post-content]");
			const toc = document.querySelector<HTMLElement>("[data-toc]");
			const list = document.querySelector("[data-toc-list]");
			const tocInline = document.querySelector<HTMLElement>("[data-toc-inline]");
			const listInline = document.querySelector("[data-toc-inline-list]");
			if (!content) return;

			const headings = [
				...content.querySelectorAll<HTMLHeadingElement>("h2, h3"),
			];
			if (toc) toc.hidden = headings.length === 0;
			if (tocInline) tocInline.hidden = headings.length === 0;
			if (headings.length === 0) return;

			const links = new Map<Element, HTMLAnchorElement[]>();
			headings.forEach((heading, index) => {
				if (!heading.id) {
					heading.id = `heading-${index}`;
				}

				const isNested = heading.tagName === "H3";
				const headingText = heading.textContent || "";

				// Populate desktop rail TOC
				if (list) {
					const item = document.createElement("li");
					item.className = isNested ? "toc__item toc__item--nested" : "toc__item";
					const link = document.createElement("a");
					link.href = `#${heading.id}`;
					link.className = "toc__link";
					link.textContent = headingText;
					item.appendChild(link);
					list.appendChild(item);

					if (!links.has(heading)) links.set(heading, []);
					links.get(heading)!.push(link);
				}

				// Populate mobile/tablet inline TOC
				if (listInline) {
					const itemInline = document.createElement("li");
					itemInline.className = isNested ? "toc__item toc__item--nested" : "toc__item";
					const linkInline = document.createElement("a");
					linkInline.href = `#${heading.id}`;
					linkInline.className = "toc__link";
					linkInline.textContent = headingText;
					itemInline.appendChild(linkInline);
					listInline.appendChild(itemInline);

					if (!links.has(heading)) links.set(heading, []);
					links.get(heading)!.push(linkInline);
				}
			});

			// Mark the section currently in view
			const setCurrent = (activeLinks: HTMLAnchorElement[]) => {
				for (const allActive of links.values()) {
					for (const l of allActive) {
						l.removeAttribute("aria-current");
					}
				}
				for (const l of activeLinks) {
					l.setAttribute("aria-current", "true");
				}
			};
			const first = links.values().next().value;
			if (first) setCurrent(first);

			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						const targetLinks = links.get(entry.target);
						if (targetLinks && entry.isIntersecting) setCurrent(targetLinks);
					}
				},
				{ rootMargin: "-80px 0px -80% 0px" },
			);

			headings.forEach((heading) => observer.observe(heading));
		}

		buildToc();
	</script>
</Base>

