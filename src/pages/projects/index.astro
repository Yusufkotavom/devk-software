---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: projects,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("projects", {
	orderBy: { created_at: "desc" },
	limit: 24,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base title="Portfolio & Projects" description="Portofolio pengerjaan sistem, website, dan proyek cetak Kotacom.">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Portfolio</p>
			<h1 class="intro__title">Proyek & Portofolio</h1>
			<p class="intro__lead">Bukti pengerjaan sistem informasi, POS retail, website profesional, dan proyek percetakan oleh Kotacom.</p>
		</div>
	</header>

	<section class="band section archive-band">
		<div class="frame">
			{
				projects.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? "Tidak ada lagi" : "Belum ada proyek"}
						</h2>
						<p class="empty-state__text">
							{cursor
								? "Anda sudah mencapai akhir portofolio."
								: "Proyek yang dipublikasikan akan tampil di sini."}
						</p>
						{cursor && (
							<div class="empty-state__actions">
								<a href="/projects" class="btn btn--ghost">
									Halaman pertama
								</a>
							</div>
						)}
					</div>
				) : (
					<>
						<div class="post-grid">
							{projects.map((project) => (
								<PostCard
									post={project as any}
									collection="projects"
									variant="card"
									headingLevel={2}
								/>
							))}
						</div>
						<Pagination basePath="/projects" cursor={cursor} nextCursor={nextCursor} />
					</>
				)
			}
		</div>
	</section>
</Base>
